              <div style="display:flex;gap:8px;margin-top:12px">
                <a href="tel:+201114536964" style="flex:1;text-align:center;text-decoration:none;padding:11px 5px;background:#252525;border:1px solid #aaa;border-radius:9px;color:white;font-weight:bold">📞 اتصال</a>
