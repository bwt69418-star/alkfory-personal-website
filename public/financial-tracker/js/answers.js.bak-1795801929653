function init() {
    const form = document.querySelector("#studentId")?.closest("form");
    const unit = document.getElementById("study-unit");
    const lesson = document.getElementById("study-lesson");
    if (!form || !unit || !lesson) return;

    let panel = document.getElementById("alkfory-answer-results");
    if (!panel) {
      panel = document.createElement("section");
      panel.id = "alkfory-answer-results";
      panel.dir = "rtl";
      panel.style.cssText = "display:none;text-align:right;padding:18px;margin:15px auto;background:#171717;color:#fff;border:1px solid #a90035;border-radius:14px;max-width:700px";
      form.parentElement.appendChild(panel);
    }

    function showAnswers() {
      const levels = data.flat();
      const levelIndex = Number(unit.value) - 1;
      const lessonIndex = Number(lesson.value) - 1;

      if (!Number.isInteger(levelIndex) || !levels[levelIndex] ||
          !Number.isInteger(lessonIndex) ||
          !levels[levelIndex].lessons ||
          !levels[levelIndex].lessons[lessonIndex]) {
        alert("اختار المستوى والدرس أولاً.");
        return;
      }

      const level = levels[levelIndex];
      const selected = level.lessons[lessonIndex];

      panel.replaceChildren();

      const pageTitle = document.createElement("h2");
      pageTitle.textContent = "صفحة الإجابات";
      pageTitle.style.cssText = "text-align:center;padding:15px;margin:0 0 18px;background:#242424;border:1px solid #a90035;border-radius:12px;color:#fff;font-size:21px";
      panel.appendChild(pageTitle);

      const heading = document.createElement("h2");
      heading.textContent = level.name;
      panel.appendChild(heading);

      const subheading = document.createElement("h3");
      subheading.textContent = selected[0];
      panel.appendChild(subheading);

      selected[1].forEach((answer, index) => {
        const row = document.createElement("p");
        row.style.cssText = "padding:12px;margin:8px 0;background:#252525;border-radius:9px;line-height:1.8";
        row.textContent = `${index + 1}- ${answer}`;
        panel.appendChild(row);
      });


      const thankButton = document.createElement("button");
      thankButton.id = "alkfory-thank-developer";
      thankButton.type = "button";
      thankButton.textContent = "⚜️ إرسال رسالة شكرًا للمطور";
      thankButton.style.cssText = "display:block;width:100%;margin:18px 0 5px;padding:15px;background:linear-gradient(120deg,#17000a,#65001f);border:1px solid #ff174f;border-radius:13px;color:white;font-size:16px;font-weight:bold;box-shadow:0 0 18px #ff174f33;cursor:pointer";
      panel.appendChild(thankButton);

      thankButton.onclick = () => {
        if (document.getElementById("alkfory-thank-modal")) return;

        const modal = document.createElement("div");
        modal.id = "alkfory-thank-modal";
        modal.style.cssText = "position:fixed;inset:0;z-index:100000;background:#000e;display:flex;align-items:center;justify-content:center;padding:16px;overflow-y:auto";

        modal.innerHTML = `
          <div dir="rtl" style="box-sizing:border-box;width:100%;max-width:440px;max-height:90vh;overflow-y:auto;background:#101010;border:1px solid #ff174f;border-radius:20px;padding:20px;color:white;box-shadow:0 0 30px #ff174f44">
            <h2 style="text-align:center;color:#ff315c;margin:0 0 14px">⚜️ شكراً لك ⚜️</h2>
            <p style="text-align:center;line-height:1.9;color:#eee;margin:0 0 18px">
              شكراً لثقتك ودعمك ❤️<br>
              يسعدني تواصلك مع المطور زياد الكفوري من خلال الأرقام التالية.
            </p>

            <div style="background:#1b1b1b;border:1px solid #713044;border-radius:13px;padding:13px;margin:12px 0">
              <div style="text-align:center;font-size:19px;font-weight:bold;direction:ltr">+20 1031808795</div>
              <div style="display:flex;gap:8px;margin-top:12px">
                <a href="tel:+201031808795" style="flex:1;text-align:center;text-decoration:none;padding:11px 5px;background:#252525;border:1px solid #aaa;border-radius:9px;color:white;font-weight:bold">📞 اتصال</a>
                <a href="https://wa.me/201031808795" target="_blank" rel="noopener" style="flex:1;text-align:center;text-decoration:none;padding:11px 5px;background:#075e36;border:1px solid #20c878;border-radius:9px;color:white;font-weight:bold">واتساب</a>
