          جارٍ اختراق المنصة بواسطة الكفوري...
        </div>
        <div style="height:12px;background:#333;border-radius:20px;overflow:hidden">
          <div id="alkfory-progress" style="height:100%;width:0%;background:#e60046;transition:width .1s linear"></div>
        </div>
        <div id="alkfory-countdown" style="margin-top:10px">جاري التحميل... 5 ثوانٍ</div>
      `;

      const progress = document.getElementById("alkfory-progress");
      const countdown = document.getElementById("alkfory-countdown");
      const started = Date.now();

      const timer = setInterval(() => {
        const elapsed = Date.now() - started;
        const percent = Math.min(100, elapsed / 5000 * 100);
        progress.style.width = percent + "%";
        countdown.textContent = elapsed >= 5000
          ? "اكتمل التحميل"
          : "جاري التحميل... " + Math.ceil((5000 - elapsed) / 1000) + " ثوانٍ";

        if (elapsed >= 5000) {
          clearInterval(timer);
          status.style.display = "none";
          showAnswers();
        }
      }, 50);
    }, true);

    document.querySelectorAll("a,button").forEach(button => {
      if (button.textContent.trim() === "الإجابات") {
        button.addEventListener("click", event => {
          if (panel.style.display !== "block") return;
          event.preventDefault();
          event.stopImmediatePropagation();
          panel.style.display = "block";
          form.parentElement.querySelectorAll(".card").forEach(card => {
            if (!card.contains(panel)) card.style.display = "none";
          });
        }, true);
      }
    });
