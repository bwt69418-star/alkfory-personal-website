.alk-password-eye {
  position: absolute !important;
  left: 2px !important;
  right: auto !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  width: 20px !important;
  min-width: 20px !important;
  height: 20px !important;
  min-height: 20px !important;
