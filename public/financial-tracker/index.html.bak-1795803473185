  place-items: center !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 4px !important;
  background: transparent !important;
  color: var(--alkfory-accent, #ff315f) !important;
  font-size: 13px !important;
  line-height: 1 !important;
  cursor: pointer !important;
  z-index: 10 !important;
  box-shadow: none !important;
}
.alk-password-wrap input {
  padding-left: 27px !important;
}
.alk-password-eye:focus-visible {
  outline: 2px solid var(--alkfory-accent, #ff315f) !important;
  border-radius: 8px !important;
}
</style>
<script>
(() => {
  function addPasswordEyes() {
    const path = location.pathname.toLowerCase();
    if (!path.includes("financial-tracker")) return;

    document.querySelectorAll('input[type="password"]').forEach(input => {
      if (input.dataset.alkEyeAdded) return;
      input.dataset.alkEyeAdded = "1";

      const wrap = document.createElement("span");
      wrap.className = "alk-password-wrap";
      input.parentNode.insertBefore(wrap, input);
      wrap.appendChild(input);

      const eye = document.createElement("button");
      eye.type = "button";
      eye.className = "alk-password-eye";
      eye.textContent = "👁";
      eye.setAttribute("aria-label", "إظهار كلمة المرور");
      eye.title = "إظهار كلمة المرور";

      eye.addEventListener("click", () => {
        const showing = input.type === "password";
        input.type = showing ? "text" : "password";
        eye.textContent = showing ? "🙈" : "👁";
        eye.setAttribute("aria-label",
          showing ? "إخفاء كلمة المرور" : "إظهار كلمة المرور");
        eye.title = showing ? "إخفاء كلمة المرور" : "إظهار كلمة المرور";
        input.focus();
      });

      wrap.appendChild(eye);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", addPasswordEyes);
  } else {
    addPasswordEyes();
  }

  new MutationObserver(addPasswordEyes).observe(document.documentElement, {
    childList: true,
    subtree: true
  });
})();
</script>





<style>
/* ALKFORY-LOGIN-FIX-V1 */
#studentId,
input[type="password"] {
  direction: rtl !important;
  text-align: right !important;
  unicode-bidi: plaintext !important;
  padding-right: 12px !important;
  padding-left: 28px !important;
  text-indent: 0 !important;
}
</style>
<script>
/* ALKFORY-LOGIN-VALIDATION-V1 */
(() => {
  const idField = document.getElementById('studentId');
  const passwordField = document.querySelector('input[type="password"]');
  if (!idField || !passwordField) return;

  idField.setAttribute('inputmode', 'numeric');
  idField.addEventListener('input', () => {
    idField.value = idField.value.replace(/\D/g, '');
  });

  document.addEventListener('submit', event => {
    const id = idField.value.trim();
    const password = passwordField.value;

    if (!/^\d{7,}$/.test(id)) {
      event.preventDefault();
      event.stopImmediatePropagation();
      alert('رقم الـ ID غلط أو الطالب غير معروف');
      idField.focus();
      return;
    }

    if (password.length < 7) {
      event.preventDefault();
      event.stopImmediatePropagation();
      alert('كلمة المرور غلط');
      passwordField.focus();
    }
  }, true);
})();
</script>


<script>
/* ALKFORY-CLEAR-ANSWERS-ON-LOAD-V2 */
(() => {
  function clearPreviousAnswers() {
    const nodes = document.querySelectorAll('[id], [class]');
    nodes.forEach(el => {
      if (!(el instanceof HTMLElement)) return;
      if (el.closest('form')) return;

      const name = ((el.id || '') + ' ' + (typeof el.className === 'string' ? el.className : '')).toLowerCase();

      if (/(answer|answers|result|results|solution|solutions)/.test(name)) {
        if (el.matches('input, textarea, select, button, script, style')) return;
        el.replaceChildren();
        el.hidden = true;
        el.setAttribute('aria-hidden', 'true');
      }
    });
  }

  document.addEventListener('change', e => {
    if (e.target.matches('#study-unit, #study-lesson')) {
      clearPreviousAnswers();
    }
  }, true);

  document.addEventListener('click', e => {
    const button = e.target.closest('button, input[type="submit"], input[type="button"]');
    if (!button) return;

    const label = ((button.innerText || button.value || '')).trim();
    if (/تحميل|عرض|إجابات|اجابات|حل|ابدأ/i.test(label)) {
      clearPreviousAnswers();
    }
  }, true);

  document.addEventListener('submit', clearPreviousAnswers, true);
})();
</script>

