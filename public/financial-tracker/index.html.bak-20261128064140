<script id="ALKFORY-LEVEL-NOTES-V2">
(() => {
  const NOTES_KEY = "alkfory_22_levels_notes_v1";
  const SCHEDULE_KEY = "alkfory_financial_study_schedule_v1";
  let reviewOpen = false;
  let data = { selectedLevel: 1, notes: {}, completedLevels: {} };
  function load() {
    try {
      const r = localStorage.getItem(NOTES_KEY);
      if (r) {
        const p = JSON.parse(r);
        if (p && typeof p === "object") {
          data.selectedLevel = Math.min(22, Math.max(1, Number(p.selectedLevel) || 1));
          data.notes = p.notes && typeof p.notes === "object" ? p.notes : {};
          data.completedLevels = p.completedLevels && typeof p.completedLevels === "object" ? p.completedLevels : {};
        }
      }
    } catch (_) {}
  }
  function save() {
    try { localStorage.setItem(NOTES_KEY, JSON.stringify(data)); } catch (_) {}
  }
  function esc(s) {
    return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function stats() {
    const set = new Set();
    try {
      const r = localStorage.getItem(SCHEDULE_KEY);
      if (r) {
        const p = JSON.parse(r);
        if (Array.isArray(p && p.tasks)) {
          p.tasks.forEach(t => {
            if (t && t.done) {
              const m = String(t.level || "").match(/(\d+)/);
              if (m) { const n = Number(m[1]); if (n >= 1 && n <= 22) set.add(n); }
            }
          });
        }
      }
    } catch (_) {}
    let rev = 0, noted = 0;
    for (let i = 1; i <= 22; i++) {
      const h = String(data.notes[i] || "").trim().length > 0;
      const c = Boolean(data.completedLevels[i]);
      if (h) noted++;
      if (c) rev++;
      if (h || c) set.add(i);
    }
    return { active: set.size, rev, noted, pct: Math.round((set.size / 22) * 100) };
  }
  function nextUnreviewed(from) {
    for (let k = 1; k <= 22; k++) {
      const n = ((from - 1 + k) % 22) + 1;
      if (!data.completedLevels[n]) return n;
    }
    return from;
  }
  function allText() {
    const out = ["ملخص ملاحظات الـ 22 مستوى — ALKFORY", "===================================="];
    let any = false;
    for (let i = 1; i <= 22; i++) {
      const n = String(data.notes[i] || "").trim();
      const r = Boolean(data.completedLevels[i]);
      if (n || r) {
        any = true;
        out.push("المستوى " + i + (r ? " [مراجع ✓]" : ""));
        if (n) out.push(n);
        out.push("------------------------------------");
      }
    }
    return any ? out.join("\n") : "لا توجد ملاحظات مسجلة بعد.";
  }
  function reviewHtml() {
    const rows = [];
    for (let i = 1; i <= 22; i++) {
      const n = String(data.notes[i] || "").trim();
      const r = Boolean(data.completedLevels[i]);
      if (n || r) {
        rows.push("<div data-lvl=\"" + i + "\" style=\"cursor:pointer;padding:8px 10px;background:#111;border:1px solid #2b2b2b;border-radius:9px;margin-bottom:6px\"><div style=\"display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px\"><strong style=\"color:#ff8aa8\">المستوى " + i + "</strong><span style=\"color:" + (r ? "#4ade80" : "#facc15") + "\">" + (r ? "مراجع ✓" : "ملاحظة 📝") + "</span></div><div style=\"font-size:12px;color:#eee;white-space:pre-wrap\">" + (n ? esc(n) : "تمت المراجعة") + "</div></div>");
      }
    }
    return rows.length ? rows.join("") : "<div style=\"font-size:12px;color:#aaa\">لا توجد ملاحظات أو مراجعات بعد.</div>";
  }
  function render(card) {
    load();
    const st = stats();
    const lvl = data.selectedLevel || 1;
    const note = data.notes[lvl] || "";
    const checked = Boolean(data.completedLevels[lvl]);
    const opts = Array.from({ length: 22 }, (_, i) => {
      const n = i + 1;
      const h = String(data.notes[n] || "").trim().length > 0;
      const mark = data.completedLevels[n] ? " ✓" : (h ? " 📝" : "");
      return "<option value=\"" + n + "\"" + (n === lvl ? " selected" : "") + ">المستوى " + n + mark + "</option>";
    }).join("");
    card.innerHTML =
      "<div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap\"><span style=\"font-size:14px;font-weight:bold;color:#ff4778\">📝 ملاحظات المستوى</span><span id=\"alk-st-lbl\" style=\"font-size:11px;color:#ccc\">متابع <strong style=\"color:#fff\">" + st.active + "</strong>/22 (" + st.pct + "%) • مراجَع: <strong style=\"color:#4ade80\">" + st.rev + "</strong> • ملاحظات: <strong style=\"color:#ff8aa8\">" + st.noted + "</strong></span></div>" +
      "<div style=\"width:100%;height:7px;background:#262626;border-radius:99px;overflow:hidden;margin-bottom:10px\"><div id=\"alk-st-bar\" style=\"width:" + st.pct + "%;height:100%;background:linear-gradient(90deg,#a90035,#ff4778)\"></div></div>" +
      "<div style=\"display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:8px;flex-wrap:wrap\"><select id=\"alk-lvl-sel\" style=\"padding:6px 10px;background:#111;color:#fff;border:1px solid #444;border-radius:8px;font-size:12px\">" + opts + "</select><div style=\"display:flex;gap:6px;flex-wrap:wrap\"><button type=\"button\" id=\"alk-next-unrev\" style=\"padding:5px 9px;background:#221017;color:#ff8aa8;border:1px solid #8f002b;border-radius:8px;font-size:11px;font-weight:bold;cursor:pointer\">التالي غير المراجع</button><button type=\"button\" id=\"alk-rev-tog\" style=\"padding:5px 9px;background:#1c1c1c;color:#fff;border:1px solid #444;border-radius:8px;font-size:11px;cursor:pointer\">" + (reviewOpen ? "إخفاء المراجعة" : "مراجعة سريعة") + "</button><button type=\"button\" id=\"alk-copy-btn\" style=\"padding:5px 9px;background:#1c1c1c;color:#4ade80;border:1px solid #2f5d3e;border-radius:8px;font-size:11px;cursor:pointer\">نسخ الكل</button></div></div>" +
      "<textarea id=\"alk-note-ta\" rows=\"3\" placeholder=\"اكتب أهم نقطة أو قانون أو فكرة في المستوى " + lvl + "...\" style=\"width:100%;box-sizing:border-box;padding:10px;background:#101010;color:#fff;border:1px solid #383838;border-radius:10px;font-size:13px;line-height:1.5;resize:vertical;outline:none\">" + esc(note) + "</textarea>" +
      "<div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap\"><label style=\"display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#ddd;cursor:pointer\"><input type=\"checkbox\" id=\"alk-done-cb\"" + (checked ? " checked" : "") + " style=\"width:15px;height:15px;accent-color:#ff4778\" /><span>مراجع المستوى " + lvl + "</span></label><div style=\"display:flex;align-items:center;gap:10px\"><button type=\"button\" id=\"alk-clr-note\" style=\"background:none;border:none;color:#ff8aa8;font-size:11px;cursor:pointer;padding:0;text-decoration:underline\">مسح ملاحظة المستوى</button><span id=\"alk-save-msg\" style=\"font-size:11px;color:#4ade80\">محفوظ تلقائياً</span></div></div>" +
      (reviewOpen ? "<div style=\"margin-top:10px;padding-top:10px;border-top:1px solid #2b2b2b;max-height:220px;overflow-y:auto\"><div style=\"font-size:12px;font-weight:bold;color:#ff4778;margin-bottom:6px\">📌 مراجعة سريعة (اضغط للانتقال)</div>" + reviewHtml() + "</div>" : "");
    card.querySelector("#alk-lvl-sel")?.addEventListener("change", e => { data.selectedLevel = Number(e.target.value) || 1; save(); render(card); });
    card.querySelector("#alk-next-unrev")?.addEventListener("click", () => { data.selectedLevel = nextUnreviewed(data.selectedLevel || 1); save(); render(card); });
    card.querySelector("#alk-rev-tog")?.addEventListener("click", () => { reviewOpen = !reviewOpen; render(card); });
    const msgEl = card.querySelector("#alk-save-msg");
    card.querySelector("#alk-copy-btn")?.addEventListener("click", async () => {
      const txt = allText();
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(txt);
        else { const t = document.createElement("textarea"); t.value = txt; document.body.appendChild(t); t.select(); document.execCommand("copy"); t.remove(); }
        if (msgEl) { msgEl.textContent = "تم نسخ الكل ✓"; msgEl.style.color = "#4ade80"; }
      } catch (_) { if (msgEl) { msgEl.textContent = "تعذر النسخ"; msgEl.style.color = "#ff8aa8"; } }
    });
    card.querySelector("#alk-clr-note")?.addEventListener("click", () => { delete data.notes[data.selectedLevel || 1]; save(); render(card); });
    card.querySelector("#alk-note-ta")?.addEventListener("input", e => {
      data.notes[data.selectedLevel || 1] = e.target.value;
      save();
      if (msgEl) { msgEl.textContent = "تم الحفظ تلقائياً ✓"; msgEl.style.color = "#4ade80"; }
      const s2 = stats();
      const b = card.querySelector("#alk-st-bar");
      const l = card.querySelector("#alk-st-lbl");
      if (b) b.style.width = s2.pct + "%";
      if (l) l.innerHTML = "متابع <strong style=\"color:#fff\">" + s2.active + "</strong>/22 (" + s2.pct + "%) • مراجَع: <strong style=\"color:#4ade80\">" + s2.rev + "</strong> • ملاحظات: <strong style=\"color:#ff8aa8\">" + s2.noted + "</strong>";
    });
    card.querySelector("#alk-done-cb")?.addEventListener("change", e => { data.completedLevels[data.selectedLevel || 1] = Boolean(e.target.checked); save(); render(card); });
    card.querySelectorAll("[data-lvl]").forEach(el => {
      el.addEventListener("click", () => { const n = Number(el.getAttribute("data-lvl")); if (n >= 1 && n <= 22) { data.selectedLevel = n; save(); render(card); } });
    });
  }
  function ensureMounted() {
    if (!document.body) return;
    let card = document.getElementById("alkfory-level-notes-card");
    if (!card) {
      card = document.createElement("section");
      card.id = "alkfory-level-notes-card";
      card.dir = "rtl";
      card.style.cssText = "display:block;width:100%;max-width:520px;margin:14px auto;padding:14px;background:#141414;border:1px solid #8f002b;border-radius:16px;box-shadow:0 6px 24px rgba(0,0,0,0.45);color:#fff";
      render(card);
    }
    const host = document.querySelector("main") || document.body;
    if (!host.contains(card)) host.appendChild(card);
  }
  const tick = () => ensureMounted();
  document.addEventListener("DOMContentLoaded", tick);
  window.addEventListener("load", tick);
  setInterval(tick, 700);
  setTimeout(tick, 100);
  setTimeout(tick, 500);
  setTimeout(tick, 1500);
})();
</script>
