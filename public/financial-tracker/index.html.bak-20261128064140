<script id="ALKFORY-FORCE-UPDATE-GATE-V1">
(() => {
  const REQUIRED_BUILD = "2026.11.28.1";
  const BUILD_KEY = "alkfory_app_build_version";
  const IS_STANDALONE =
    window.matchMedia?.("(display-mode: standalone)").matches ||
    window.navigator.standalone === true ||
    document.referrer.startsWith("android-app://");

  function getInstalledBuild() {
    try {
      return localStorage.getItem(BUILD_KEY) || "legacy";
    } catch (_) {
      return "legacy";
    }
  }

  function markCurrentBuildInstalled() {
    try {
      localStorage.setItem(BUILD_KEY, REQUIRED_BUILD);
    } catch (_) {}
  }

  function showForceUpdateScreen(currentBuild) {
    if (document.getElementById("alkfory-force-update-overlay")) return;

    const overlay = document.createElement("div");
    overlay.id = "alkfory-force-update-overlay";
    overlay.dir = "rtl";
    overlay.style.cssText = [
      "position:fixed",
      "inset:0",
      "z-index:2147483647",
      "background:#070707",
      "color:#fff",
      "display:flex",
      "align-items:center",
      "justify-content:center",
      "padding:20px",
      "font-family:inherit",
      "text-align:center"
    ].join(";");

    const box = document.createElement("div");
    box.style.cssText = [
      "width:100%",
      "max-width:410px",
      "background:#141414",
      "border:1px solid #c2003d",
      "border-radius:18px",
      "padding:24px 18px",
      "box-shadow:0 16px 45px rgba(0,0,0,0.85)"
    ].join(";");

    box.innerHTML = `
      <div style="font-size:38px;margin-bottom:10px">⚠️</div>
      <h2 style="margin:0 0 8px;color:#ff4778;font-size:20px">تحديث إجباري مطلوب</h2>
      <p style="margin:0 0 16px;color:#ccc;font-size:13px;line-height:1.7">
        تم نشر تعديلات جديدة على <strong style="color:#fff">ALKFORY</strong> ولا يمكن فتح التطبيق بالنسخة القديمة حتى يتم التحديث إلى الإصدار الجديد.
      </p>
      <div style="background:#1c1c1c;border:1px solid #2e2e2e;border-radius:10px;padding:10px;font-size:12px;color:#aaa;margin-bottom:16px">
        <div>النسخة الحالية: <strong style="color:#ff8aa8">${currentBuild}</strong></div>
        <div style="margin-top:4px">النسخة المطلوبة: <strong style="color:#4ade80">${REQUIRED_BUILD}</strong></div>
      </div>
      <button type="button" id="alk-do-update-now" style="width:100%;padding:12px;background:linear-gradient(120deg,#7a0026,#c2003d);color:#fff;border:1px solid #ff4778;border-radius:11px;font-size:14px;font-weight:bold;cursor:pointer;margin-bottom:8px">
        تحديث وتحميل أحدث نسخة الآن
      </button>
      <button type="button" id="alk-check-update-again" style="width:100%;padding:10px;background:#202020;color:#ddd;border:1px solid #3c3c3c;border-radius:11px;font-size:12px;font-weight:bold;cursor:pointer">
        إعادة التحقق بعد التحديث
      </button>
    `;

    overlay.appendChild(box);
    document.body.appendChild(overlay);

    box.querySelector("#alk-do-update-now")?.addEventListener("click", async () => {
      try {
        if ("serviceWorker" in navigator) {
          const regs = await navigator.serviceWorker.getRegistrations();
          for (const r of regs) await r.update();
        }
        if (window.caches && caches.keys) {
          const keys = await caches.keys();
          await Promise.all(keys.map(k => caches.delete(k)));
        }
      } catch (_) {}
      const url = new URL(window.location.href);
      url.searchParams.set("v", REQUIRED_BUILD);
      url.searchParams.set("t", String(Date.now()));
      window.location.replace(url.toString());
    });

    box.querySelector("#alk-check-update-again")?.addEventListener("click", () => {
      window.location.reload();
    });
  }

  function enforceUpdateGate() {
    const params = new URLSearchParams(window.location.search);
    const urlBuild = params.get("v");
    const installedBuild = getInstalledBuild();

    // لو المستخدم فتح النسخة الجديدة فعلاً من الرابط المحدث أو تم تثبيتها
    if (urlBuild === REQUIRED_BUILD || installedBuild === REQUIRED_BUILD) {
      markCurrentBuildInstalled();
      if (urlBuild === REQUIRED_BUILD) {
        params.delete("v");
        params.delete("t");
        const cleanUrl = window.location.pathname + (params.toString() ? "?" + params.toString() : "") + window.location.hash;
        window.history.replaceState({}, "", cleanUrl);
      }
      return;
    }

    // لو التطبيق مثبت (Standalone / WebAPK) أو له نسخة سابقة غير مطابقة للإصدار المطلوب
    if (IS_STANDALONE || installedBuild !== "legacy") {
      showForceUpdateScreen(installedBuild);
    } else {
      // أول زيارة للمتصفح العادي تحصل على النسخة الجديدة مباشرة
      markCurrentBuildInstalled();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", enforceUpdateGate, { once: true });
  } else {
    enforceUpdateGate();
  }
})();
</script>

