<script id="ALKFORY-NEXT-LESSON-V1">
(() => {
  const installNextButton = () => {
    const panel = document.getElementById("alkfory-answer-results");
    const lesson = document.getElementById("study-lesson");
    if (!panel || !lesson || panel.querySelector("#alkfory-next-lesson")) return;

    const button = document.createElement("button");
    button.id = "alkfory-next-lesson";
    button.type = "button";
    button.textContent = "الدرس التالي ⟵";
    button.style.cssText =
      "display:block;width:100%;margin:14px 0;padding:14px;background:#171717;color:white;border:1px solid #ff174f;border-radius:12px;font-size:16px;font-weight:bold";

    button.addEventListener("click", () => {
      const nextIndex = lesson.selectedIndex + 1;
      if (nextIndex >= lesson.options.length) {
        button.textContent = "لا يوجد درس تالٍ في هذه الوحدة";
        return;
      }

      lesson.selectedIndex = nextIndex;
      lesson.dispatchEvent(new Event("change", { bubbles: true }));

      const form = lesson.closest("form");
      if (form) {
        if (typeof form.requestSubmit === "function") form.requestSubmit();
        else form.dispatchEvent(new Event("submit", { bubbles: true, cancelable: true }));
      }
    });

    panel.appendChild(button);
  };

  new MutationObserver(installNextButton).observe(document.body, {
    childList: true,
    subtree: true
  });
  installNextButton();
})();
</script>


<script id="ALKFORY-THANK-CONTACTS-V1">
(() => {
  const phonePattern = /(?:\+?20|0020|0)?1[0125]\d{8}/g;

  function normalizePhone(value) {
    let n = String(value || "").replace(/[^\d+]/g, "");
    if (n.startsWith("+20")) n = "0" + n.slice(3);
    else if (n.startsWith("0020")) n = "0" + n.slice(4);
    else if (/^20?1[0125]\d{8}$/.test(n)) n = "0" + n.replace(/^20?/, "");
    return /^01[0125]\d{8}$/.test(n) ? n : "";
  }

  function getContacts() {
    const found = new Map();

    document.querySelectorAll('a[href]').forEach(a => {
      const href = a.getAttribute("href") || "";
      const text = a.innerText || a.textContent || "";
      const isWhatsApp = /wa\.me|whatsapp|api\.whatsapp/i.test(href + " " + text);
      const isPhone = /^tel:/i.test(href);

      if (!isWhatsApp && !isPhone) return;

      const candidates = (href + " " + text).match(phonePattern) || [];
      candidates.forEach(raw => {
        const number = normalizePhone(raw);
        if (number && !found.has(number)) {
          found.set(number, {
            number,
            type: isWhatsApp ? "واتساب" : "اتصال هاتفي"
          });
        }
      });
    });

    return [...found.values()].slice(0, 3);
  }

  function showContacts() {
    const old = document.getElementById("alkfory-thank-contacts-modal");
    if (old) old.remove();

    const contacts = getContacts();
    const overlay = document.createElement("div");
    overlay.id = "alkfory-thank-contacts-modal";
    overlay.dir = "rtl";
    overlay.style.cssText =
      "position:fixed;inset:0;z-index:1000005;background:#000d;display:flex;align-items:center;justify-content:center;padding:15px";

    const box = document.createElement("section");
    box.style.cssText =
      "width:100%;max-width:430px;background:#111;color:white;border:1px solid #b00035;border-radius:16px;padding:20px;text-align:center";

    const title = document.createElement("h3");
    title.textContent = "⚜️ تواصل مع المطور زياد الكفوري ⚜️";
    title.style.color = "#ff315c";
    box.appendChild(title);

    const description = document.createElement("p");
    description.textContent = "اختار وسيلة التواصل المناسبة:";
    box.appendChild(description);

    const contactNumbers = ["01031808795", "01114536964"];

    contactNumbers.forEach((number) => {
      const card = document.createElement("div");
      card.style.cssText =
        "margin:12px 0;padding:13px;background:#1b1b1b;border:1px solid #b00035;border-radius:12px";

      const numberText = document.createElement("div");
      numberText.textContent = "📞 " + number;
      numberText.style.cssText =
        "font-size:18px;font-weight:bold;margin-bottom:12px;color:#fff;direction:ltr";
      card.appendChild(numberText);

      const actions = document.createElement("div");
      actions.style.cssText = "display:flex;gap:9px;justify-content:center";

      const call = document.createElement("a");
      call.textContent = "📞 اتصال";
      call.href = "tel:" + number;

      const whatsapp = document.createElement("a");
      whatsapp.textContent = "واتساب";
      const intlNum = number.startsWith("20") ? number : ("20" + number.replace(/^0+/, "")); whatsapp.href = "https://wa.me/" + intlNum;
      whatsapp.target = "_blank";
      whatsapp.rel = "noopener noreferrer";

      [call, whatsapp].forEach((button) => {
        button.style.cssText =
          "flex:1;padding:12px 8px;background:#292929;color:white;text-decoration:none;border:1px solid #ff315c;border-radius:9px;font-weight:bold";
        actions.appendChild(button);
      });

      card.appendChild(actions);
      box.appendChild(card);
    });

    const close = document.createElement("button");
    close.type = "button";
    close.textContent = "إغلاق";
    close.style.cssText =
      "width:100%;padding:12px;margin-top:10px;background:#a90035;color:white;border:0;border-radius:9px";
    close.onclick = () => overlay.remove();
    box.appendChild(close);

    overlay.addEventListener("click", e => {
      if (e.target === overlay) overlay.remove();
    });

    overlay.appendChild(box);
    document.body.appendChild(overlay);
  }

  document.addEventListener("click", event => {
    const button = event.target.closest("#alkfory-thank-developer");
    if (!button) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    showContacts();
  }, true);
})();
</script>


