<script id="alkfory-final-validation">
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("loginForm");
  const id = document.getElementById("studentId");
  const password = document.getElementById("password");
  const unit = document.getElementById("study-unit");
  const lesson = document.getElementById("study-lesson");
  const button = form?.querySelector('button[type="submit"]');

  if (!form || !id || !password || !unit || !lesson || !button) return;

  [id, password, unit, lesson].forEach(field => field.required = true);

  id.setAttribute("inputmode", "numeric");
  id.setAttribute("pattern", "[0-9]+");

  function checkFields() {
    const valid =
      /^[0-9]+$/.test(id.value.trim()) &&
      password.value.trim() !== "" &&
      unit.value !== "" &&
      lesson.value !== "";

    button.disabled = !valid;
    return valid;
  }

  id.addEventListener("input", function () {
    this.value = this.value.replace(/[^0-9]/g, "");
    checkFields();
  });

  id.addEventListener("paste", function () {
    setTimeout(() => {
      id.value = id.value.replace(/[^0-9]/g, "");
      checkFields();
    }, 0);
  });

  [password, unit, lesson].forEach(field => {
    field.addEventListener("input", checkFields);
    field.addEventListener("change", checkFields);
  });

  form.addEventListener("submit", function (event) {
    if (!checkFields()) {
      event.preventDefault();
      event.stopImmediatePropagation();
      alert("أكمل جميع الخانات واختر المستوى والدرس أولاً.");
    }
  }, true);

  checkFields();
});
</script>


<script id="alkfory-longpress-hints">
document.addEventListener("DOMContentLoaded", function(){
  const hints = [
    {id:"studentId", text:"أدخل معرف الطالب الخاص بك بمنصة الثقافة المالية"},
    {id:"password", text:"أدخل كلمة المرور الخاصة بك في منصة الثقافة المالية"}
  ];
  const box = document.createElement("div");
  box.id = "alkfory-hint";
  box.innerHTML = '<div class="hint-box"><div id="alkfory-hint-text"></div><button type="button">حسناً</button></div>';
  document.body.appendChild(box);

  function showHint(text){
    document.getElementById("alkfory-hint-text").textContent = text;
    box.style.display = "flex";
  }
  box.querySelector("button").addEventListener("click",()=>box.style.display="none");
  box.addEventListener("click",e=>{if(e.target===box)box.style.display="none";});

  hints.forEach(item=>{
    const input=document.getElementById(item.id);
    if(!input) return;
    let timer;
    input.addEventListener("touchstart",()=>{
      timer=setTimeout(()=>showHint(item.text),650);
    },{passive:true});
    ["touchend","touchmove","touchcancel"].forEach(ev=>
      input.addEventListener(ev,()=>clearTimeout(timer),{passive:true})
    );
    input.addEventListener("contextmenu",e=>{
      e.preventDefault();
      showHint(item.text);
    });
  });
});
</script>


