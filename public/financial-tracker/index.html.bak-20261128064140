    menuBtn.style.cssText = [
      "display:inline-flex",
      "align-items:center",
      "justify-content:center",
      "width:34px",
      "height:34px",
      "flex-shrink:0",
      "border:1px solid #b00035",
      "background:#151515",
      "color:#ff2a2a",
      "border-radius:10px",
      "font-size:22px",
      "line-height:1",
      "cursor:pointer"
    ].join(";");

    const brand = document.getElementById("alkfory-brand");
    let brandTitle = document.getElementById("alkfory-top-wordmark");
    const existingImg = brand ? brand.querySelector("img") : null;

    if (!brandTitle) {
      brandTitle = document.createElement("span");
      brandTitle.id = "alkfory-top-wordmark";
      brandTitle.textContent = "ALKFORY";
      brandTitle.style.cssText = [
        "font-size:20px",
        "font-weight:800",
        "color:#ff2020",
        "letter-spacing:1.5px",
        "line-height:1"
      ].join(";");
    }

    if (leftGroup.parentElement !== header) {
      header.appendChild(leftGroup);
    }
    if (menuBtn.parentElement !== leftGroup) {
      leftGroup.appendChild(menuBtn);
    }
    if (brandTitle.parentElement !== leftGroup) {
      leftGroup.appendChild(brandTitle);
    }

    // الجانب الأيمن: الصورة الدائرية فقط في الشريط العلوي
    if (existingImg) {
      existingImg.style.cssText = [
        "width:48px",
        "height:48px",
        "border-radius:50%",
        "object-fit:cover",
        "border:2px solid #b00035",
        "display:block",
        "flex-shrink:0"
      ].join(";");
      if (existingImg.parentElement !== header) {
        header.appendChild(existingImg);
      }
    }
    if (brand && brand.parentElement) {
      // إخفاء حاوية brand القديمة إذا كانت تحتوي على نص مكرر أو أزرار إضافية مع الإبقاء على الصورة
      brand.style.display = "none";
    }

    if (!menuBtn.dataset.alkExactBound) {
      menuBtn.dataset.alkExactBound = "1";
      menuBtn.addEventListener("click", (e) => {
        const panel = document.getElementById("alkfory-menu-panel");
        const settingsModal = document.getElementById("alkfory-settings");
        if (panel) {
          e.stopPropagation();
          const open = panel.style.display === "block";
          panel.style.display = open ? "none" : "block";
          panel.style.left = "14px";
          panel.style.right = "auto";
          panel.style.top = "56px";
          panel.style.zIndex = "10000";
        } else if (settingsModal) {
          e.stopPropagation();
          settingsModal.style.display = "flex";
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", applyExactTopBar);
  window.addEventListener("load", applyExactTopBar);
  setTimeout(applyExactTopBar, 200);
  setTimeout(applyExactTopBar, 800);
})();
</script>



<script id="ALKFORY-SCHEDULE-BTN-AND-LOGIC-V2">
(() => {
  const STORAGE_KEY = "alkfory_financial_study_schedule_v1";
  const DAYS = ["السبت", "الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"];
  const TASKS_PRESETS = [
    "مذاكرة الدرس الأول",
    "مذاكرة الدرس الثاني",
    "مذاكرة الدرس الثالث",
    "حل اختبار المستوى",
    "مراجعة شاملة للمستوى",
    "تلخيص وحفظ المفاهيم",
    "مراجعة الأخطاء السابقة"
  ];
  const DURATIONS_PRESETS = [
    "١٥ دقيقة",
    "٣٠ دقيقة",
    "٤٥ دقيقة",
    "٦٠ دقيقة",
    "٩٠ دقيقة",
    "ساعتان"
  ];
  const PRIORITIES = {
    high: { label: "أولوية قصوى", color: "#ff4778", bg: "rgba(255,71,120,0.14)" },
    medium: { label: "متوسطة", color: "#ffb84d", bg: "rgba(255,184,77,0.14)" },
    review: { label: "مراجعة", color: "#4dd2ff", bg: "rgba(77,210,255,0.14)" }
  };

  let state = {
    viewMode: "days",
    selectedDay: DAYS[0],
    tasks: []
  };

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && Array.isArray(parsed.tasks)) {
          state = {
            viewMode: parsed.viewMode === "levels" ? "levels" : "days",
            selectedDay: DAYS.includes(parsed.selectedDay) ? parsed.selectedDay : DAYS[0],
            tasks: parsed.tasks
          };
        }
      }
    } catch (_) {}
  }

  function saveState() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (_) {}
  }

  function escapeHtml(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function computeStats() {
    const total = state.tasks.length;
    const done = state.tasks.filter(t => t.done).length;
    const pct = total ? Math.round((done / total) * 100) : 0;
    return { total, done, pct };
  }

  function ensureScheduleButton() {
    if (document.getElementById("alkfory-open-schedule-btn")) return;

    const titleEl = [...document.querySelectorAll("h1, h2, h3, .title, div, span")].find(el => {
      if (el.id === "alkfory-study-schedule-modal" || el.closest?.("#alkfory-study-schedule-modal")) return false;
      if (el.id === "alkfory-brand" || el.closest?.("#alkfory-brand") || el.closest?.("header")) return false;
      return (el.textContent || "").trim() === "الثقافة المالية" && el.children.length <= 3;
    });

    const btn = document.createElement("button");
    btn.id = "alkfory-open-schedule-btn";
    btn.type = "button";
    btn.title = "جدول المذاكرة";
    btn.setAttribute("aria-label", "جدول المذاكرة");
    btn.innerHTML = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><rect x="3" y="4" width="18" height="18" rx="3"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><line x1="8" y1="14" x2="16" y2="14"></line><line x1="8" y1="18" x2="13" y2="18"></line></svg>`;
    btn.style.cssText = [
      "display:inline-flex",
      "align-items:center",
      "justify-content:center",
      "width:32px",
      "height:32px",
      "margin-right:8px",
      "vertical-align:middle",
      "background:linear-gradient(135deg,#2a000e,#a90035)",
      "color:#fff",
      "border:1px solid #ff4778",
      "border-radius:9px",
      "cursor:pointer"
    ].join(";");

    if (titleEl) {
      titleEl.insertAdjacentElement("afterend", btn);
    } else if (document.body) {
      document.body.insertBefore(btn, document.body.firstChild);
    }
  }

  function renderScheduleBody(container) {
    const stats = computeStats();
    const dayFilter = state.selectedDay;

    const taskOptions = TASKS_PRESETS.map(t => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join("");
    const levelOptions = Array.from({ length: 22 }, (_, i) => {
      const n = i + 1;
      return `<option value="المستوى ${n}">المستوى ${n}</option>`;
    }).join("");
    const durationOptions = DURATIONS_PRESETS.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join("");

    const dayTabsHtml = DAYS.map(d => {
      const count = state.tasks.filter(t => t.day === d).length;
      const active = d === dayFilter;
      return `
        <button type="button" data-day="${d}" class="alk-day-tab" style="padding:7px 11px;border-radius:9px;border:1px solid ${active ? "#ff4778" : "#3a3a3a"};background:${active ? "linear-gradient(135deg,#5a001c,#a90035)" : "#1d1d1d"};color:#fff;font-size:12px;font-weight:bold;cursor:pointer;white-space:nowrap">
          ${d}${count ? ` <span style="background:#0007;padding:1px 6px;border-radius:99px;font-size:11px;color:#ffd1de">${count}</span>` : ""}
        </button>
      `;
    }).join("");

    function renderTaskCard(task) {
      const p = PRIORITIES[task.priority] || PRIORITIES.medium;
      return `
        <div data-task-id="${task.id}" style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;background:#1a1a1a;border:1px solid ${task.done ? "#246b48" : "#333"};border-radius:11px;padding:11px 12px;margin-bottom:8px;opacity:${task.done ? "0.78" : "1"}">
          <div style="display:flex;align-items:flex-start;gap:10px;flex:1;min-width:0">
            <input type="checkbox" class="alk-task-toggle" data-id="${task.id}" ${task.done ? "checked" : ""} style="width:18px;height:18px;margin-top:2px;accent-color:#ff4778;cursor:pointer;flex-shrink:0" />
            <div style="flex:1;min-width:0">
              <div style="font-size:14px;font-weight:bold;color:${task.done ? "#9ae6be" : "#fff"};text-decoration:${task.done ? "line-through" : "none"};word-break:break-word">
                ${escapeHtml(task.title)}
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;align-items:center">
                <span style="font-size:11px;padding:2px 8px;border-radius:7px;background:#271018;border:1px solid #8a1c3d;color:#ff8aa8">${escapeHtml(task.level)}</span>
                <span style="font-size:11px;padding:2px 8px;border-radius:7px;background:#222;color:#ddd">${escapeHtml(task.day)}</span>
                ${task.duration ? `<span style="font-size:11px;padding:2px 8px;border-radius:7px;background:#222;color:#ccc">⏱ ${escapeHtml(task.duration)}</span>` : ""}
                <span style="font-size:11px;padding:2px 8px;border-radius:7px;background:${p.bg};color:${p.color};border:1px solid ${p.color}55">${p.label}</span>
              </div>
            </div>
          </div>
          <button type="button" class="alk-task-del" data-id="${task.id}" title="حذف المهمة" style="background:#2b1118;color:#ff6b93;border:1px solid #691930;border-radius:8px;padding:5px 9px;font-size:12px;cursor:pointer;flex-shrink:0">✕</button>
        </div>
      `;
    }

    let listHtml = "";
    if (state.viewMode === "days") {
      const dayTasks = state.tasks.filter(t => t.day === dayFilter);
      listHtml = `
        <div style="display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:10px">${dayTabsHtml}</div>
        <div style="font-size:12px;color:#bbb;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">
          <span>مهام يوم <strong style="color:#ff4778">${dayFilter}</strong> (${dayTasks.length})</span>
          <span style="color:#888">محفوظ تلقائياً</span>
        </div>
        ${dayTasks.length ? dayTasks.map(renderTaskCard).join("") : `<div style="text-align:center;padding:22px 12px;background:#181818;border:1px dashed #3a3a3a;border-radius:11px;color:#999;font-size:13px">لا توجد مهام مسجلة ليوم ${dayFilter} بعد. اختر من القوائم في الأعلى واحفظ!</div>`}
      `;
    } else {
      const grouped = {};
      state.tasks.forEach(t => {
        const key = t.level || "غير محدد";
        if (!grouped[key]) grouped[key] = [];
        grouped[key].push(t);
      });
      const keys = Object.keys(grouped);
      listHtml = keys.length
        ? keys.map(lvl => `
            <div style="margin-bottom:12px">
              <div style="font-size:13px;font-weight:bold;color:#ff6b93;background:#220b12;border:1px solid #691930;padding:6px 10px;border-radius:9px;margin-bottom:6px">
                ${escapeHtml(lvl)} (${grouped[lvl].length})
              </div>
              ${grouped[lvl].map(renderTaskCard).join("")}
            </div>
          `).join("")
        : `<div style="text-align:center;padding:22px 12px;background:#181818;border:1px dashed #3a3a3a;border-radius:11px;color:#999;font-size:13px">لم تقم بإضافة مهام لأي مستوى بعد.</div>`;
    }

    container.innerHTML = `
      <div style="background:#191919;border:1px solid #383838;border-radius:12px;padding:12px;margin-bottom:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#ddd;margin-bottom:7px">
          <span>نسبة إنجاز الجدول: <strong style="color:#ff4778">${stats.pct}%</strong></span>
          <span>منجز: <strong>${stats.done}</strong> / <strong>${stats.total}</strong></span>
        </div>
        <div style="width:100%;height:8px;background:#2b2b2b;border-radius:99px;overflow:hidden">
          <div style="width:${stats.pct}%;height:100%;background:linear-gradient(90deg,#a90035,#ff4778);transition:width 0.25s ease"></div>
        </div>
      </div>

      <div id="alk-schedule-form" style="background:#181818;border:1px solid #441625;border-radius:12px;padding:12px;margin-bottom:14px">
        <div style="font-size:13px;font-weight:bold;color:#ff6b93;margin-bottom:8px">+ إضافة مهمة مذاكرة جديدة</div>
        <select id="alk-task-title" style="width:100%;box-sizing:border-box;padding:10px 12px;margin-bottom:8px;background:#111;color:#fff;border:1px solid #3c3c3c;border-radius:9px;font-size:13px;outline:none">${taskOptions}</select>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
          <select id="alk-task-level" style="padding:9px;background:#111;color:#fff;border:1px solid #3c3c3c;border-radius:9px;font-size:12px">${levelOptions}</select>
          <select id="alk-task-day" style="padding:9px;background:#111;color:#fff;border:1px solid #3c3c3c;border-radius:9px;font-size:12px">${DAYS.map(d => `<option value="${d}" ${d === dayFilter ? "selected" : ""}>${d}</option>`).join("")}</select>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px">
          <select id="alk-task-duration" style="padding:9px 10px;background:#111;color:#fff;border:1px solid #3c3c3c;border-radius:9px;font-size:12px">${durationOptions}</select>
          <select id="alk-task-priority" style="padding:9px;background:#111;color:#fff;border:1px solid #3c3c3c;border-radius:9px;font-size:12px">
            <option value="high">أولوية قصوى</option>
            <option value="medium" selected>أولوية متوسطة</option>
            <option value="review">مراجعة سريعة</option>
          </select>
        </div>
        <button type="button" id="alk-save-task-btn" style="width:100%;padding:10px;background:linear-gradient(120deg,#7a0026,#c2003d);color:#fff;border:1px solid #ff4778;border-radius:10px;font-size:14px;font-weight:bold;cursor:pointer">حفظ في جدول المذاكرة</button>
      </div>

      <div style="display:flex;gap:8px;margin-bottom:10px">
        <button type="button" id="alk-view-days" style="flex:1;padding:8px;border-radius:9px;border:1px solid ${state.viewMode === "days" ? "#ff4778" : "#383838"};background:${state.viewMode === "days" ? "#2e0915" : "#181818"};color:#fff;font-size:12px;font-weight:bold;cursor:pointer">عرض حسب الأيام</button>
        <button type="button" id="alk-view-levels" style="flex:1;padding:8px;border-radius:9px;border:1px solid ${state.viewMode === "levels" ? "#ff4778" : "#383838"};background:${state.viewMode === "levels" ? "#2e0915" : "#181818"};color:#fff;font-size:12px;font-weight:bold;cursor:pointer">عرض حسب المستويات</button>
      </div>

      <div id="alk-schedule-list">${listHtml}</div>

      <div style="margin-top:14px;padding-top:10px;border-top:1px solid #2b2b2b">
        <button type="button" id="alk-clear-done" style="width:100%;padding:9px;background:#222;color:#ffb84d;border:1px solid #554422;border-radius:9px;font-size:12px;font-weight:bold;cursor:pointer">🧹 حذف المهام المنجزة</button>
      </div>
    `;

    const titleSelect = container.querySelector("#alk-task-title");
    const levelSelect = container.querySelector("#alk-task-level");
    const daySelect = container.querySelector("#alk-task-day");
    const durationSelect = container.querySelector("#alk-task-duration");
    const prioritySelect = container.querySelector("#alk-task-priority");

    container.querySelector("#alk-save-task-btn")?.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      ev.stopImmediatePropagation();
      const val = (titleSelect.value || TASKS_PRESETS[0]).trim();
      const chosenDay = daySelect.value || state.selectedDay;
      state.selectedDay = chosenDay;
      state.tasks.unshift({
        id: "t_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
        title: val,
        level: levelSelect.value,
        day: chosenDay,
        duration: (durationSelect.value || "").trim(),
        priority: prioritySelect.value,
        done: false
      });
      saveState();
      renderScheduleBody(container);
    }, true);

    container.querySelectorAll(".alk-day-tab").forEach(tab => {
      tab.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        state.selectedDay = tab.getAttribute("data-day");
        saveState();
        renderScheduleBody(container);
      }, true);
    });

    container.querySelector("#alk-view-days")?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      state.viewMode = "days";
      saveState();
      renderScheduleBody(container);
    }, true);

    container.querySelector("#alk-view-levels")?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      state.viewMode = "levels";
      saveState();
      renderScheduleBody(container);
    }, true);

    container.querySelectorAll(".alk-task-toggle").forEach(chk => {
      chk.addEventListener("change", (e) => {
        e.stopPropagation();
        e.stopImmediatePropagation();
        const id = chk.getAttribute("data-id");
        const item = state.tasks.find(t => t.id === id);
        if (item) {
          item.done = chk.checked;
          saveState();
          renderScheduleBody(container);
        }
      }, true);
    });

    container.querySelectorAll(".alk-task-del").forEach(delBtn => {
      delBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const id = delBtn.getAttribute("data-id");
        state.tasks = state.tasks.filter(t => t.id !== id);
        saveState();
        renderScheduleBody(container);
      }, true);
    });

    container.querySelector("#alk-clear-done")?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      state.tasks = state.tasks.filter(t => !t.done);
      saveState();
      renderScheduleBody(container);
    }, true);
  }

  function openScheduleModal() {
    loadState();
    const old = document.getElementById("alkfory-study-schedule-modal");
    if (old) old.remove();

    const overlay = document.createElement("div");
    overlay.id = "alkfory-study-schedule-modal";
    overlay.dir = "rtl";
    overlay.style.cssText = "position:fixed;inset:0;z-index:1000010;background:rgba(0,0,0,0.82);display:flex;align-items:center;justify-content:center;padding:14px";

    const card = document.createElement("section");
    card.style.cssText = "width:100%;max-width:520px;max-height:88vh;overflow-y:auto;background:#141414;color:#fff;border:1px solid #b00035;border-radius:16px;padding:16px;box-shadow:0 12px 35px rgba(0,0,0,0.75);font-family:inherit";

    const header = document.createElement("div");
    header.style.cssText = "display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid #2d2d2d";
    header.innerHTML = `
      <div>
        <div style="font-size:17px;font-weight:bold;color:#ff4778">📅 جدول المذاكرة الذكي</div>
        <div style="font-size:11px;color:#aaa;margin-top:2px">يُحفظ تلقائياً على جهازك دون الحاجة لإعادة إنشائه</div>
      </div>
      <button type="button" id="alk-close-schedule" style="background:#262626;color:#fff;border:1px solid #444;border-radius:9px;padding:6px 12px;font-size:13px;font-weight:bold;cursor:pointer">إغلاق ✕</button>
    `;

    const body = document.createElement("div");
    renderScheduleBody(body);

    card.appendChild(header);
    card.appendChild(body);
    overlay.appendChild(card);
    document.body.appendChild(overlay);

    card.querySelector("#alk-close-schedule")?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      overlay.remove();
    }, true);

    overlay.addEventListener("click", (ev) => {
      if (ev.target === overlay) overlay.remove();
    });
  }

  window.alkforyOpenStudySchedule = openScheduleModal;

  document.addEventListener("click", (event) => {
    const btn = event.target.closest?.("#alkfory-open-schedule-btn");
    if (!btn) return;
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
    openScheduleModal();
  }, true);

  function init() {
    loadState();
    ensureScheduleButton();
  }

  document.addEventListener("DOMContentLoaded", init);
  window.addEventListener("load", init);
  setTimeout(init, 250);
  setTimeout(init, 900);
})();
</script>


<script id="ALKFORY-LIVE-SEARCH-FIX-V1">
(() => {
  function norm(str) {
    return String(str || "")
      .toLowerCase()
      .replace(/[أإآا]/g, "ا")
      .replace(/ى/g, "ي")
      .replace(/ة/g, "ه")
      .replace(/[٠-٩]/g, d => String(d.charCodeAt(0) - 1632))
      .trim();
  }

  function collectSearchItems(query) {
    const q = norm(query);
    if (!q) return [];
    const results = [];
    const seen = new Set();

    // 1. البحث في خيارات القوائم المنسدلة (المستويات والدروس وغيرها)
    document.querySelectorAll("select").forEach((sel, sIdx) => {
      if (sel.closest?.("#alkfory-study-schedule-modal")) return;
      Array.from(sel.options || []).forEach((opt, oIdx) => {
        const label = (opt.textContent || opt.label || "").trim();
        if (!label || opt.disabled) return;
        if (norm(label).includes(q)) {
          const key = "opt:" + sIdx + ":" + oIdx + ":" + label;
          if (!seen.has(key)) {
            seen.add(key);
            results.push({
              title: label,
              meta: "اختيار / درس أو مستوى",
              run: () => {
                sel.value = opt.value;
                sel.dispatchEvent(new Event("change", { bubbles: true }));
                sel.scrollIntoView({ behavior: "smooth", block: "center" });
              }
            });
          }
        }
      });
    });

    // 2. البحث في العناوين والأزرار والروابط والعناصر الظاهرة في الصفحة
    const candidates = document.querySelectorAll("h1, h2, h3, h4, button, a, label, [role=button], .card, section");
    candidates.forEach((el, idx) => {
      if (
        el.id === "alkfory-live-search-results" ||
        el.closest?.("#alkfory-live-search-results") ||
        el.closest?.("#alkfory-study-schedule-modal") ||
        el.closest?.("#alkfory-menu-panel")
      ) return;

      const text = (el.innerText || el.textContent || "").trim().replace(/\s+/g, " ");
      if (!text || text.length > 140) return;

      if (norm(text).includes(q)) {
        const key = "el:" + idx + ":" + text;
        if (!seen.has(key)) {
          seen.add(key);
          results.push({
            title: text,
            meta: el.tagName === "A" ? "رابط / منصة" : (el.tagName === "BUTTON" ? "زر" : "قسم في الصفحة"),
            run: () => {
              if (el.tagName === "A" && el.href && !el.href.startsWith("javascript:")) {
                el.scrollIntoView({ behavior: "smooth", block: "center" });
                el.click();
              } else {
                el.scrollIntoView({ behavior: "smooth", block: "center" });
                if (typeof el.click === "function") el.click();
              }
            }
          });
        }
      }
    });

    return results.slice(0, 18);
  }

  function findSearchInput() {
    const inputs = Array.from(document.querySelectorAll("input[type=search], input[type=text], input:not([type])"));
    return inputs.find(inp => {
      if (inp.closest?.("#alkfory-study-schedule-modal")) return false;
      const ph = (inp.getAttribute("placeholder") || "").trim();
      const ar = (inp.getAttribute("aria-label") || "").trim();
      return ph.includes("ابحث") || ph.includes("بحث") || ar.includes("ابحث") || ar.includes("بحث");
    }) || null;
  }

  function renderResultsBox(input) {
    if (!input || !input.parentElement) return;
    let box = document.getElementById("alkfory-live-search-results");
    if (!box) {
      box = document.createElement("div");
      box.id = "alkfory-live-search-results";
      box.setAttribute("dir", "rtl");
      box.style.cssText = [
        "margin-top:8px",
        "max-height:240px",
        "overflow-y:auto",
        "background:#121212",
        "border:1px solid #b00035",
        "border-radius:10px",
        "padding:6px",
        "z-index:100005"
      ].join(";");
      input.insertAdjacentElement("afterend", box);
    }

    const q = (input.value || "").trim();
    if (!q) {
      box.style.display = "none";
      box.innerHTML = "";
      return;
    }

    const items = collectSearchItems(q);
    box.style.display = "block";

    if (!items.length) {
      box.innerHTML = `<div style="padding:10px;text-align:center;color:#aaa;font-size:12px">لا توجد نتائج مطابقة لـ "${q.replace(/</g, "&lt;")}"</div>`;
      return;
    }

    box.innerHTML = "";
    items.forEach(item => {
      const row = document.createElement("button");
      row.type = "button";
      row.style.cssText = [
        "display:flex",
        "flex-direction:column",
        "align-items:flex-start",
        "width:100%",
        "text-align:right",
        "padding:8px 10px",
        "margin-bottom:5px",
        "background:#1c1c1c",
        "color:#fff",
        "border:1px solid #333",
        "border-radius:8px",
        "cursor:pointer"
      ].join(";");

      const titleSpan = document.createElement("span");
      titleSpan.textContent = item.title;
      titleSpan.style.cssText = "font-size:13px;font-weight:bold;color:#ff8aa8";

      const metaSpan = document.createElement("span");
      metaSpan.textContent = item.meta;
      metaSpan.style.cssText = "font-size:11px;color:#999;margin-top:2px";

      row.appendChild(titleSpan);
      row.appendChild(metaSpan);

      row.addEventListener("click", (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        const menuPanel = document.getElementById("alkfory-menu-panel");
        if (menuPanel) menuPanel.style.display = "none";
        box.style.display = "none";
        item.run();
      }, true);

      box.appendChild(row);
    });
  }

  function attachLiveSearch() {
    const input = findSearchInput();
    if (!input || input.dataset.alkLiveBound) return;
    input.dataset.alkLiveBound = "1";

    const handler = () => renderResultsBox(input);
    input.addEventListener("input", handler, true);
    input.addEventListener("keyup", handler, true);
    input.addEventListener("focus", handler, true);
  }

  document.addEventListener("DOMContentLoaded", attachLiveSearch);
  window.addEventListener("load", attachLiveSearch);
  const obs = new MutationObserver(() => attachLiveSearch());
  obs.observe(document.documentElement, { childList: true, subtree: true });
  setTimeout(attachLiveSearch, 250);
  setTimeout(attachLiveSearch, 900);
})();
</script>





<script id="ALKFORY-NEXT-LESSON-WITH-ANSWERS-V1">
(() => {
  let answersShown = false;

  function findNextLessonButtons() {
    const els = Array.from(document.querySelectorAll("button, a, [role=button], div"));
    return els.filter(el => {
      if (el.id === "alkfory-smart-continue-btn" || (el.closest && el.closest("#alkfory-smart-continue-wrap"))) return false;
      if (el.children && el.children.length > 2) return false;
      const t = (el.textContent || "").replace(/s+/g, " ").trim();
      return /^الدرس التالي(?:s*[←→<>-]|$)/.test(t);
    });
  }

  function hasAnswersDisplayed() {
    const bodyText = (document.body && (document.body.innerText || document.body.textContent)) || "";
    if (/الإجابة|الاجابة|إجابة|اجابة|الإجابات|الاجابات|شرح الحل|النموذجية|السؤالs*d+|سؤالs*d+/i.test(bodyText)) {
      const answerBoxes = document.querySelectorAll("[class*=answer i], [id*=answer i], [class*=result i], [class*=solution i], [class*=question i]");
      if (answerBoxes.length > 0) return true;
      if (/الإجابةs*[:：]|الاجابةs*[:：]|الإجابات|الاجابات|شرح الحل/i.test(bodyText)) return true;
    }
    return false;
  }

  function applyNextLessonVisibility() {
    const btns = findNextLessonButtons();
    if (!btns.length) return;
    btns.forEach(btn => {
      btn.style.display = answersShown ? "" : "none";
    });
  }

  function hideOnSelectionChange() {
    answersShown = false;
    applyNextLessonVisibility();
  }

  function checkAnswersAndSync() {
    if (hasAnswersDisplayed()) {
      answersShown = true;
    }
    applyNextLessonVisibility();
  }

  document.addEventListener("change", (e) => {
    const el = e.target;
    if (el && el.tagName === "SELECT" && !(el.closest && el.closest("#alkfory-study-schedule-modal"))) {
      hideOnSelectionChange();
    }
  }, true);

  document.addEventListener("click", (e) => {
    const target = e.target && e.target.closest ? e.target.closest("button, a, [role=button], input[type=submit]") : null;
    if (!target) return;
    const txt = (target.textContent || target.value || "").replace(/s+/g, " ").trim();
    if (txt.includes("اختراق المنصة") || txt === "↩ استكمال" || txt.includes("استكمال")) {
      hideOnSelectionChange();
    }
  }, true);

  function boot() {
    checkAnswersAndSync();
  }

  document.addEventListener("DOMContentLoaded", boot);
  window.addEventListener("load", boot);
  setTimeout(boot, 200);
  setTimeout(boot, 800);
  setInterval(checkAnswersAndSync, 600);

  const obs = new MutationObserver(() => {
    checkAnswersAndSync();
  });
  if (document.documentElement) {
    obs.observe(document.documentElement, { childList: true, subtree: true, characterData: true });
  }
})();
</script>



<script id="ALKFORY-MOVE-NOTES-BELOW-LOGIN-V1">
(() => {
  function findLoginBox() {
    const candidates = Array.from(document.querySelectorAll("button, a, [role=button], input[type=submit], select, input[type=password]"));
    const anchorEl = candidates.find(el => {
      if (el.closest && el.closest("#alkfory-level-notes-card")) return false;
      if (el.type === "password") return true;
      const t = (el.textContent || el.value || "").replace(/s+/g, " ").trim();
      return t.includes("اختراق المنصة") || t.includes("اختر المستوى") || t.includes("اختر الدرس");
    });

    if (!anchorEl) return null;

    let box = anchorEl.parentElement;
    let bestBox = box;

    while (box && box !== document.body && box !== document.documentElement) {
      const hasControls = box.querySelector("select") || box.querySelector("input[type=password]");
      const text = (box.textContent || "").replace(/s+/g, " ").trim();
      const mentionsPlatforms = text.includes("منصاتك التعليمية") || text.includes("المنصات التعليمية");

      if (hasControls && !mentionsPlatforms) {
        bestBox = box;
      } else if (mentionsPlatforms) {
        break;
      }
      box = box.parentElement;
    }

    return bestBox;
  }

  function placeNotesBelowLogin() {
    const card = document.getElementById("alkfory-level-notes-card");
    if (!card) return;

    const loginBox = findLoginBox();
    if (loginBox && loginBox.parentElement) {
      if (loginBox.nextElementSibling !== card) {
        loginBox.parentElement.insertBefore(card, loginBox.nextElementSibling);
      }
      return;
    }

    const allEls = Array.from(document.querySelectorAll("h1, h2, h3, h4, h5, p, div, span, section"));
    const platformsEl = allEls.find(el => {
      if (el === card || card.contains(el)) return false;
      const t = (el.textContent || "").replace(/s+/g, " ").trim();
      return t.length > 0 && t.length <= 60 && (t.includes("منصاتك التعليمية") || t.includes("المنصات التعليمية"));
    });

    if (platformsEl && platformsEl.parentElement) {
      let anchor = platformsEl;
      while (anchor.parentElement && anchor.parentElement !== document.body && anchor.parentElement.children.length === 1) {
        anchor = anchor.parentElement;
      }
      if (anchor.parentElement && anchor.previousElementSibling !== card) {
        anchor.parentElement.insertBefore(card, anchor);
      }
    }
  }

  document.addEventListener("DOMContentLoaded", placeNotesBelowLogin);
  window.addEventListener("load", placeNotesBelowLogin);
  setTimeout(placeNotesBelowLogin, 150);
  setTimeout(placeNotesBelowLogin, 500);
  setTimeout(placeNotesBelowLogin, 1200);
  setTimeout(placeNotesBelowLogin, 2500);

  const obs = new MutationObserver(() => placeNotesBelowLogin());
  if (document.documentElement) {
    obs.observe(document.documentElement, { childList: true, subtree: true });
  }
})();
</script>





