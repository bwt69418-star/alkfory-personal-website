<title>Ziad Alkfory</title>

<style>
:root {
  --red: #ff263f;
  --green: #00ff88;
  --bg: #050505;
  --panel: #101010;
  --muted: #999;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background:
    radial-gradient(ellipse at 50% 0%, #44101955, transparent 45%),
    var(--bg);
  color: white;
  font-family: Arial, sans-serif;
  min-height: 100vh;
}
button, a { font: inherit; }
a { color: inherit; text-decoration: none; }
button { cursor: pointer; }
header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #080808eF;
  backdrop-filter: blur(15px);
  border-bottom: 1px solid #242424;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 5%;
  direction: ltr;
}
.brand {
  color: white;
  font-weight: 900;
  letter-spacing: 2px;
}
.brand span { color: var(--red); }
.lang {
  color: white;
  background: #151515;
  border: 1px solid #3b2529;
  border-radius: 10px;
  padding: 9px 14px;
}
main { max-width: 850px; margin: auto; padding: 35px 20px; }
.hero { text-align: center; padding: 30px 0 25px; }
.emblem {
  width: 145px;
  height: 145px;
  border-radius: 50%;
  margin: 0 auto 25px;
  display: grid;
  place-items: center;
  position: relative;
  font-size: 47px;
  font-weight: 900;
  color: white;
  background: linear-gradient(145deg, #1b1b1b, #080808);
  border: 2px solid #a81d30;
  box-shadow: 0 0 15px #ff263f44, inset 0 0 24px #ff263f12;
  animation: float 4s ease-in-out infinite;
}
.emblem:after {
  content: "";
  position: absolute;
  width: 13px;
  height: 13px;
  bottom: 8px;
  right: 10px;
  background: var(--green);
  border: 3px solid #080808;
  border-radius: 50%;
  box-shadow: 0 0 15px var(--green);
}
@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-7px); }
}
.status {
  color: var(--green);
  font-size: 13px;
  margin: 0 0 17px;
}
.status i {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: var(--green);
  border-radius: 50%;
  margin-left: 6px;
  box-shadow: 0 0 9px var(--green);
}
h1 { font-size: clamp(30px, 6vw, 48px); margin: 8px 0 13px; }
.red { color: var(--red); }
.subtitle { color: #aaa; line-height: 1.9; }
.hero-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 25px;
}
.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  padding: 14px 20px;
  border: 1px solid #383838;
  background: #111;
  border-radius: 12px;
  color: white;
  transition: .2s;
}
.btn:hover {
  transform: translateY(-2px);
  border-color: var(--red);
  box-shadow: 0 0 18px #ff263f20;
}
.primary {
  background: linear-gradient(110deg, #c8102e, #751020);
  border-color: #ed3048;
}
.section-title { text-align: center; margin: 45px 0 20px; }
.section-title h2 { margin-bottom: 8px; }
.section-title p { color: var(--muted); font-size: 14px; }
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
.card {
  background: linear-gradient(145deg, #131313, #0a0a0a);
  border: 1px solid #292929;
  border-radius: 17px;
  padding: 20px;
  transition: .25s;
}
.card:hover {
  border-color: #a51e31;
  transform: translateY(-3px);
}
.card-icon { font-size: 27px; margin-bottom: 13px; }
.card h3 { margin: 0 0 8px; font-size: 17px; }
.card p { color: #999; font-size: 13px; line-height: 1.8; }
.card .btn { width: 100%; margin-top: 10px; padding: 11px; }
.ai-box {
  border: 1px solid #49212a;
  background: radial-gradient(ellipse at top right, #40101a55, transparent 70%), #0d0d0d;
  border-radius: 18px;
  padding: 22px;
}
.ai-box textarea {
  width: 100%;
  min-height: 90px;
  resize: vertical;
  background: #080808;
  border: 1px solid #333;
  border-radius: 12px;
  color: white;
  padding: 14px;
  outline: none;
  margin: 12px 0;
  font: inherit;
}
.ai-box textarea:focus { border-color: var(--red); }
#aiAnswer {
  display: none;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background: #080808;
  padding: 14px;
  border-radius: 12px;
  line-height: 1.8;
  margin-top: 14px;
}
footer {
  margin-top: 50px;
  border-top: 1px solid #242424;
  padding: 25px 15px;
  text-align: center;
  color: #888;
  font-size: 12px;
}
footer strong { color: #eee; }
@media(max-width:560px) {
  main { padding: 20px 15px; }
  .grid { grid-template-columns: 1fr; }
  .emblem { width: 125px; height: 125px; }
  header { padding: 13px 15px; }
  .hero { padding-top: 25px; }
}
</style>

