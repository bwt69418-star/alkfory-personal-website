<script id="alkfory-contact-to-chat">
(function () {
  function goToChat(e) {
    const el = e.target.closest('a,button,[role="button"]');
    if (!el) return;

    const label = (el.innerText || el.textContent || '')
      .replace(/\s+/g, ' ').trim();

    if (!label.includes('تواصل معي')) return;

    const chat = document.getElementById('alkforyChat');
    if (!chat) return;

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    history.replaceState(null, '', '#alkforyChat');
    chat.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('click', goToChat, true);

  function fixCopyright() {
    // حذف n أو \n إذا كانا نصًا منفصلًا في نهاية الصفحة فقط
    const walker = document.createTreeWalker(
      document.body, NodeFilter.SHOW_TEXT
    );
    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);

    for (const node of nodes) {
      const value = node.nodeValue.trim();
      if (value === 'n' || value === '\\n') {
        const parent = node.parentElement;
        if (parent && !parent.closest('script,style,textarea,input')) {
          node.remove();
        }
      }
    }

    // نقل حقوق النشر إلى آخر الصفحة
    const candidates = [...document.body.querySelectorAll('p,small,div,span')]
      .filter(el => {
        const t = (el.innerText || '').trim();
        return t.length < 180 &&
          (t.includes('حقوق النشر') ||
           t.includes('جميع الحقوق محفوظة') ||
           t.includes('All rights reserved'));
      });

    let copyright = candidates.find(el =>
      ![...el.children].some(child =>
        (child.innerText || '').includes('حقوق النشر')
      )
    ) || candidates[0];

    if (copyright) {
      copyright.id = 'alkforyCopyright';
      const footer = document.querySelector('footer') ||
        document.body.appendChild(document.createElement('footer'));
      footer.appendChild(copyright);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixCopyright);
  } else {
    fixCopyright();
  }
})();
</script>



