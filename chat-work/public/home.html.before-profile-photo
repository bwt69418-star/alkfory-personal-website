<script>
let english = false;
document.getElementById('year').textContent = new Date().getFullYear();

function toggleLang() {
  english = !english;
  document.documentElement.lang = english ? 'en' : 'ar';
  document.documentElement.dir = english ? 'ltr' : 'rtl';
  document.getElementById('langBtn').textContent = english ? 'العربية' : 'English';
  const text = {
    onlineText:['الموقع متاح للزيارة','Website available'],
    heroDesc:['أهلًا بك في موقعي الشخصي<br>كل طرق التواصل والخدمات في مكان واحد.','Welcome to my personal website.<br>All my contact links in one place.'],
    contactTop:['✉️ تواصل معي','✉️ Contact me'],
    aiTop:['✦ جرّب Ziad Alkfory AI','✦ Try Ziad Alkfory AI'],
    socialHeading:['⚡ حساباتي وروابطي','⚡ My Social Links'],
    socialDesc:['اختار المنصة اللي تحب تتواصل من خلالها','Choose your preferred platform'],
    waDesc:['تواصل مباشر عبر أرقام الواتساب.','Contact me using WhatsApp numbers.'],
    waBtn:['عرض أرقام التواصل ←','View contact numbers →'],
    fbDesc:['زور صفحتي على فيسبوك.','Visit my Facebook page.'],
    ttDesc:['تابع حسابي على تيك توك.','Follow me on TikTok.'],
    tgDesc:['تواصل معي على تيليجرام.','Contact me on Telegram.'],
    igDesc:['افتح إنستجرام لاستكشاف الحساب.','Open Instagram to explore accounts.'],
    websiteTitle:['موقعي الشخصي','Personal Website'],
    websiteDesc:['كل ما يخص Ziad Alkfory في مكان واحد.','Everything Ziad Alkfory in one place.'],
    homeBtn:['العودة للأعلى ↑','Back to top ↑'],
    aiDesc:['اسأل المساعد الذكي — إذا كان مفتاح Gemini مضبوطًا.','Ask the AI assistant — requires a configured Gemini key.'],
    aiLabel:['اكتب سؤالك هنا','Enter your question'],
    aiBtn:['إرسال إلى Ziad Alkfory AI ↗','Send to Ziad Alkfory AI ↗'],
    rights:['جميع الحقوق محفوظة','All rights reserved']
  };
  for (const [id, values] of Object.entries(text))
    document.getElementById(id).innerHTML = values[english ? 1 : 0];
  document.getElementById('heroName').innerHTML = english
    ? 'Ziad <span class="red">Ziad Alkfory</span>'
    : 'زياد <span class="red">الكفوري</span>';
  document.getElementById('aiInput').placeholder = english ? 'Type your message...' : 'اكتب رسالتك...';
}

async function askAI() {
  const input = document.getElementById('aiInput');
  const answer = document.getElementById('aiAnswer');
  const message = input.value.trim();
  if (!message) {
    answer.style.display = 'block';
    answer.textContent = english ? 'Please type a question first.' : 'اكتب سؤالك الأول.';
    return;
  }
  answer.style.display = 'block';
  answer.textContent = english ? 'Connecting...' : 'جاري الاتصال...';
  try {
    const response = await fetch('/api/ai', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({message})
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'AI request failed');
    answer.textContent = data.answer || (english ? 'No response.' : 'لم يصل رد.');
  } catch (error) {
    answer.textContent = (english ? 'Connection error: ' : 'خطأ في الاتصال: ') + error.message;
  }
}


