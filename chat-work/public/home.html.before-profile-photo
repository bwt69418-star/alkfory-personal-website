<section id="alkforyChat" class="ai-box" style="margin:30px auto;padding:20px;max-width:850px;background:#111;color:white;border:1px solid #8b0000;border-radius:16px">
  <h2 style="color:#e53935"><span class="alk-chat-heading">⚜️ محادثة خاصة مع المطوّر</span></h2>
  <div id="chatRegister">
    <input id="chatName" maxlength="60" placeholder="اسمك" style="width:100%;padding:12px;margin:8px 0">
    <input id="chatPhone" maxlength="25" placeholder="رقم الهاتف (اختياري)" style="width:100%;padding:12px;margin:8px 0">
    <button class="btn primary" onclick="startAlkforyChat()">بدء المحادثة</button><p id="chatStatus" role="status"></p>
  </div>
  <div id="chatRoom" hidden>
    <div id="chatMessages" style="height:360px;overflow-y:auto;background:#080808;padding:12px;border-radius:12px"></div>
    <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
      <input id="chatText" placeholder="اكتب رسالتك..." maxlength="3000" style="flex:1;min-width:150px;padding:12px">
      <button onclick="sendAlkforyChat()">إرسال</button>
      <label style="padding:10px;background:#8b0000;border-radius:8px;cursor:pointer">📎
        <input id="chatFile" type="file" accept="image/*,video/mp4,video/webm,application/pdf" hidden onchange="sendAlkforyChat()">
      </label>
      <label style="padding:10px;background:#8b0000;border-radius:8px;cursor:pointer">📷
        <input id="chatCamera" type="file" accept="image/*" capture="environment" hidden onchange="sendAlkforyChat(true)">
      </label>
    </div>
    <p id="chatRoomStatus" role="status"></p>
  </div>
</section>
<style>
#alkforyChat input{box-sizing:border-box;border-radius:8px;border:1px solid #555;background:#191919;color:white}
.alk-chat-message{padding:10px 13px;margin:9px 0;border-radius:12px;max-width:85%;overflow-wrap:anywhere}
.alk-chat-visitor{background:#651010;margin-left:auto}
.alk-chat-developer{background:#292929;margin-right:auto}
.alk-chat-message small{display:block;color:#ccc;font-size:11px;margin-top:6px}
#chatMessages img,#chatMessages video{max-width:100%;max-height:220px;border-radius:8px}
