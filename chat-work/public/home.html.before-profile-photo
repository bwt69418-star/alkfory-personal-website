<script>
(() => {
 const ID_KEY='alkfory_chat_id';
 const TOKEN_KEY='alkfory_chat_token';
 const $=id=>document.getElementById(id);
 let chatTimer=null;

 async function chatRequest(url, options={}) {
   const token=localStorage.getItem(TOKEN_KEY)||'';
   const headers={...(options.headers||{}),'x-chat-token':token};
   const response=await fetch(url,{credentials:'same-origin',...options,headers});
   const data=await response.json().catch(()=>({}));
   if(!response.ok) throw new Error(data.error||'تعذر تنفيذ الطلب');
   return data;
 }

 window.startAlkforyChat=async function(){
   const name=$('chatName').value.trim();
   const status=document.querySelector('#chatRegister #chatStatus');
   if(!name){
     if(status) status.textContent='اكتب اسمك أولاً';
     return;
   }
   const button=document.querySelector('#chatRegister button');
   if(button) button.disabled=true;
   if(status) status.textContent='جاري بدء المحادثة...';

   try{
     const response=await fetch('/api/chat/start',{
       method:'POST',
       credentials:'same-origin',
       headers:{'Content-Type':'application/json'},
       body:JSON.stringify({
         name,
         phone:$('chatPhone').value.trim()
       })
     });

     const data=await response.json();
     if(!response.ok) throw new Error(data.error||'تعذر بدء المحادثة');
     if(!data.id || !data.token) throw new Error('بيانات المحادثة غير مكتملة');

     localStorage.setItem(ID_KEY,data.id);
     localStorage.setItem(TOKEN_KEY,data.token);

     $('chatRegister').hidden=true;
     $('chatRoom').hidden=false;

     await loadAlkforyChat();
   }catch(e){
     if(status) status.textContent=e.message||'حدث خطأ أثناء بدء المحادثة';
     $('chatRegister').hidden=false;
     $('chatRoom').hidden=true;
   }finally{
     if(button) button.disabled=false;
   }
 };

 async function loadAlkforyChat(){
   const id=localStorage.getItem(ID_KEY);
   const token=localStorage.getItem(TOKEN_KEY);
   if(!id||!token)return;
   try{
     const data=await chatRequest('/api/chat/'+encodeURIComponent(id));
     $('chatRegister').hidden=true;
     $('chatRoom').hidden=false;
     renderAlkforyMessages(data.chat.messages||[]);
   }catch(e){
     localStorage.removeItem(ID_KEY);
     localStorage.removeItem(TOKEN_KEY);
     $('chatRegister').hidden=false;
     $('chatRoom').hidden=true;
   }
 }

 function renderAlkforyMessages(messages){
   const box=$('chatMessages');
   box.replaceChildren();
   let previousDay='';
   for(const m of messages){
     const date=new Date(m.date);
     const day=date.toLocaleDateString('ar-EG');
     if(day!==previousDay){
       const divider=document.createElement('div');
       divider.textContent=day;
       divider.style='width:fit-content;margin:12px auto;padding:4px 12px;text-align:center;background:rgba(180,35,50,.10);color:#e9bfc3;border-radius:7px;font-size:11px';
       box.appendChild(divider);
       previousDay=day;
     }
     const item=document.createElement('div');
     item.className='alk-chat-message '+(m.sender==='visitor'?'alk-chat-visitor':'alk-chat-developer');
     if(m.text){
       const text=document.createElement('div');
       text.textContent=m.text;
       item.appendChild(text);
     }
     if(m.file){
       const link=document.createElement('a');
       link.textContent='📎 '+m.file.name;
       link.style='color:#ff7777;display:block;margin-top:8px';
       link.href='/api/chat-media/'+encodeURIComponent(localStorage.getItem(ID_KEY))+'/'+encodeURIComponent(m.id)+'?token='+encodeURIComponent(localStorage.getItem(TOKEN_KEY));
       link.target='_blank';
       item.appendChild(link);
       if(m.file.type.startsWith('image/')){
         const img=document.createElement('img');
         img.src=link.href;
         item.appendChild(img);
       }else if(m.file.type.startsWith('video/')){
         const video=document.createElement('video');
         video.src=link.href;video.controls=true;
         item.appendChild(video);
       }
     }
     const time=document.createElement('small');
     time.className='alk-chat-time';
     time.textContent=date.toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'});
     item.appendChild(time);
     box.appendChild(item);
   }
   box.scrollTop=box.scrollHeight;
 }

 window.sendAlkforyChat=async function(camera=false){
   const id=localStorage.getItem(ID_KEY);
   const text=$('chatText').value.trim();
   const input=$(camera?'chatCamera':'chatFile');
   const file=input.files&&input.files[0];
   if(!text&&!file)return;
   if(file&&file.size>3*1024*1024){
     $('chatStatus').textContent='الحد الأقصى لحجم الملف 3 ميجابايت';
     input.value='';return;
   }
   const form=new FormData();
   if(text)form.append('text',text);
   if(file)form.append('file',file);
   try{
     $('chatStatus').textContent='جارٍ الإرسال...';
     await chatRequest('/api/chat/'+encodeURIComponent(id)+'/messages',{method:'POST',body:form});
     $('chatText').value='';
     input.value='';
     $('chatStatus').textContent='';
     await loadAlkforyChat();
   }catch(e){$('chatStatus').textContent=e.message;}
 };

 window.addEventListener('DOMContentLoaded',()=>{
   const cta=document.getElementById('contactTop');
   if(cta)cta.href='#alkforyChat';
   loadAlkforyChat();
   chatTimer=setInterval(loadAlkforyChat,4000);
 });
})();
</script>



