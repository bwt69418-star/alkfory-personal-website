<script>
(() => {
  if (window.__ALKFORY_VOICE_COMPLETE_FIX) return;
  window.__ALKFORY_VOICE_COMPLETE_FIX = true;

  const $ = s => document.querySelector(s);
  const screen = $('#alkforyVoiceScreen');
  const call = $('#alkCallButton');
  const photo = $('#alkVoicePhoto');
  const caption = $('#alkVoiceCaption');
  const cancel = $('#alkVoiceCancel');
  const pause = $('#alkVoicePause');
  const close = $('#alkVoiceClose');

  const input = $('#text') || $('#message') || $('#form textarea') ||
                $('#form input[type="text"]');
  const form = $('#form') || (input && input.closest('form'));

  const profile = $('header img[alt="صورة المطور"]') ||
                  $('header img[src*="alkfory-profile"]') ||
                  $('img[src*="alkfory-profile"]');

  if (profile && photo) {
    photo.src = profile.currentSrc || profile.src;
    photo.style.display = 'block';
    photo.onerror = () => {
      photo.src = '/alkfory-profile.jpg';
      photo.style.display = 'block';
    };
  }

  function setCaption(text) {
    if (caption) caption.textContent = text;
  }

  function speak(text, done) {
    if (!('speechSynthesis' in window) || !text) {
      if (done) done();
      return;
    }
    speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'ar-EG';
    utterance.rate = 0.94;
    utterance.pitch = 1.12;

    const voices = speechSynthesis.getVoices();
    const female = voices.find(v =>
      /ar/i.test(v.lang) && /female|hoda|salma|amira|laila|layla/i.test(v.name)
    );
    const arabic = voices.find(v => /ar/i.test(v.lang));
    if (female || arabic) utterance.voice = female || arabic;

    utterance.onend = () => done && done();
    utterance.onerror = () => done && done();
    speechSynthesis.speak(utterance);
  }

  const Recognition = window.SpeechRecognition ||
                      window.webkitSpeechRecognition;
  let recognition = null;
  let active = false;
  let paused = false;
  let waitingReply = false;
  let lastReply = '';
  let observer = null;

  function findReply() {
    const nodes = document.querySelectorAll(
      '.message.assistant,.assistant-message,[data-role="assistant"],' +
      '.ai-message,.message.bot,.bot-message'
    );
    for (let i = nodes.length - 1; i >= 0; i--) {
      const t = (nodes[i].innerText || nodes[i].textContent || '').trim();
      if (t && t !== lastReply && t.length > 2) return t;
    }
    return '';
  }

  function startListening() {
    if (!active || paused || waitingReply || !recognition) return;
    try {
      recognition.start();
      setCaption('سامعك… اتكلم دلوقتي');
    } catch (e) {}
  }

  function stopListening() {
    if (recognition) {
      try { recognition.stop(); } catch (e) {}
    }
  }

  function startObserver() {
    if (observer) observer.disconnect();

    observer = new MutationObserver(() => {
      if (!active || !waitingReply) return;
      const reply = findReply();
      if (!reply) return;

      lastReply = reply;
      waitingReply = false;
      observer.disconnect();

      speak(reply, () => {
        if (active && !paused) {
          setCaption('اتفضل، سامعك تاني');
          setTimeout(startListening, 500);
        }
      });
    });

    observer.observe(document.body, {
      childList:true, subtree:true, characterData:true
    });

    setTimeout(() => {
      if (waitingReply) {
        const reply = findReply();
        if (reply) {
          lastReply = reply;
          waitingReply = false;
          observer.disconnect();
          speak(reply, () => {
            if (active && !paused) startListening();
          });
        }
      }
    }, 1800);
  }

  function submitSpeech(text) {
    if (!input || !form) {
      setCaption('مش قادر أوصل لمربع الكتابة');
      return;
    }
    input.value = text;
    input.dispatchEvent(new Event('input', {bubbles:true}));
    waitingReply = true;
    startObserver();
    stopListening();
    setCaption('ثواني، بفكر في الرد…');
    if (form.requestSubmit) form.requestSubmit();
    else form.dispatchEvent(new Event('submit', {bubbles:true,cancelable:true}));
  }

  if (Recognition) {
    recognition = new Recognition();
    recognition.lang = 'ar-EG';
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.onresult = event => {
      const text = event.results?.[0]?.[0]?.transcript?.trim();
      if (text) submitSpeech(text);
    };
    recognition.onerror = event => {
      if (active) setCaption('مشكلة في الميكروفون: ' + event.error);
    };
    recognition.onend = () => {
      if (active && !paused && !waitingReply) {
        setTimeout(startListening, 500);
      }
    };
  }

  async function openVoice() {
    if (!screen) return;

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      alert('افتح الموقع من Chrome عبر اتصال آمن HTTPS حتى يعمل الميكروفون.');
      return;
    }

    try {
      setCaption('اسمح باستخدام الميكروفون لبدء المحادثة');

      // طلب الإذن يظهر بعد ضغط المستخدم على زر الدردشة
      const stream = await navigator.mediaDevices.getUserMedia({audio:true});
      stream.getTracks().forEach(track => track.stop());

      active = true;
      paused = false;
      waitingReply = false;
      screen.classList.add('alk-voice-active');
      screen.style.setProperty('display','flex','important');

      if (profile && photo) {
        photo.src = profile.currentSrc || profile.src;
        photo.style.display = 'block';
      }

      if (!Recognition) {
        setCaption('المتصفح لا يدعم الاستماع الصوتي. استخدم Chrome.');
        speak('الميكروفون اتفعل، لكن المتصفح لا يدعم الاستماع الصوتي.');
        return;
      }

      setCaption('أهلًا بيك، أنا سامعاك. اتكلم براحتك.');
      speak('أهلًا بيك! أنا معاك، قولّي محتاج إيه؟', () => {
        if (active && !paused) startListening();
      });

    } catch (err) {
      active = false;
      setCaption(
        err.name === 'NotAllowedError'
          ? 'إذن الميكروفون مرفوض. اسمح به من نافذة المتصفح.'
          : 'تعذر تشغيل الميكروفون: ' + err.name
      );
    }
  }

  function closeVoice() {
    active = false;
    paused = false;
    waitingReply = false;
    stopListening();
    if (observer) observer.disconnect();
    if ('speechSynthesis' in window) speechSynthesis.cancel();
    if (screen) {
      screen.classList.remove('alk-voice-active');
      screen.style.setProperty('display','none','important');
    }
  }

  function togglePause() {
    if (!active) return;
    paused = !paused;
    if (paused) {
      stopListening();
      if ('speechSynthesis' in window) speechSynthesis.pause();
      setCaption('المحادثة متوقفة مؤقتًا');
      if (pause) pause.textContent = 'استئناف';
    } else {
      if ('speechSynthesis' in window) speechSynthesis.resume();
      if (pause) pause.textContent = 'إيقاف مؤقت';
      setCaption('رجعنا، اتكلم');
      startListening();
    }
  }

  if (call) call.addEventListener('click', e => {
    e.preventDefault();
    e.stopImmediatePropagation();
    openVoice();
  }, true);

  if (cancel) cancel.addEventListener('click', closeVoice);
  if (close) close.addEventListener('click', closeVoice);
  if (pause) pause.addEventListener('click', togglePause);

  // ترحيب يظهر داخل المحادثة عند فتح الصفحة
  function addWelcome() {
    const box = $('#messages') || $('.messages') ||
                $('#chatMessages') || $('#chat-messages');
    if (!box || box.querySelector('.alkfory-auto-welcome')) return;

    const welcome = document.createElement('div');
    welcome.className = 'alkfory-auto-welcome';
    welcome.textContent = 'إزيك! أنا معاك، قولّي محتاج إيه؟';
    welcome.style.cssText =
      'margin:12px auto;padding:12px 16px;max-width:88%;' +
      'background:#171717;color:#fff;border:1px solid #8d0019;' +
      'border-radius:16px;text-align:right;direction:rtl;';
    box.appendChild(welcome);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', addWelcome, {once:true});
  } else {
    addWelcome();
  }
})();
</script>
