   });
   reader.onerror=reject;
   reader.readAsDataURL(imageFile);
  });
 }
 history.push({role:'user',text:message || 'أرسلت صورة', image:!!image});
 save();draw();input.value='';document.getElementById('image').value='';
 statusBox.innerHTML='<span class="alk-ai-spinner" role="status" aria-label="جاري الرد"><span>⟳</span><span>⟳</span></span>';
