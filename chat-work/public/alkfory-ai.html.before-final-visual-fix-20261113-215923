<script>
(() => {
  const button = document.getElementById('alkInstallBtn');
  if (!button) return;

  const standalone = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    window.navigator.standalone === true;

  function updateInstallButton() {
    const area = document.getElementById('alkInstallArea');
    if (standalone()) {
      area.hidden = true;
      button.hidden = true;
    }
  }

  updateInstallButton();
  window.addEventListener('appinstalled', () => {
    button.hidden = true;
    document.getElementById('alkInstallArea').hidden = true;
  });

  window.addEventListener('beforeinstallprompt', event => {
    event.preventDefault();
    if (standalone()) return;
    window.alkInstallPrompt = event;
    button.hidden = false;
  });

  button.addEventListener('click', async () => {
    const promptEvent = window.alkInstallPrompt;
    if (!promptEvent) return;
    promptEvent.prompt();
    await promptEvent.userChoice;
    window.alkInstallPrompt = null;
    button.hidden = true;
  });

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }
})();
</script>


