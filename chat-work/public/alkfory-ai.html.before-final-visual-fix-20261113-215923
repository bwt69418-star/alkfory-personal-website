<div id="alkInstallArea" style="padding:8px 16px;text-align:center"><button id="alkInstallBtn" type="button" hidden>تثبيت تطبيق الكفوري</button></div>
<main>
<div id="messages" aria-live="polite"></div>
<p id="status">مساعدك جاهز. اكتب سؤالك.</p>
<form id="form">
<textarea id="text" placeholder="" maxlength="4000" rows="1" aria-label="اكتب رسالتك"></textarea>
<label id="attachButton" title="إرفاق صورة أو فيديو أو ملف" aria-label="إرفاق صورة أو فيديو أو ملف">📎<input id="image" type="file" accept="image/*,audio/*,video/*,.pdf,.txt,.doc,.docx,.ppt,.pptx,.xls,.xlsx" hidden></label>
<button id="alkCallButton" type="button" aria-label="مكالمة" title="مكالمة">📞</button>
<button id="alkMicButton" type="button" aria-label="تحدث" title="تحدث">🎙️</button>
<button id="send" aria-label="إرسال" title="إرسال">↑</button>
</form>
</main>
<script>
const box=document.getElementById('messages');
const form=document.getElementById('form');
const input=document.getElementById('text');
const statusBox=document.getElementById('status');
const historyKey='alkfory_ai_history_v1';
let history=[];
try{history=JSON.parse(localStorage.getItem(historyKey)||'[]')}catch(e){history=[]}
function save(){localStorage.setItem(historyKey,JSON.stringify(history.slice(-80)))}

function draw(){
 box.innerHTML='';
 for(const m of history){
  const el=document.createElement('div');
  el.className='msg '+(m.role==='user'?'user':'ai');
  el.textContent=m.text;
  box.appendChild(el);

  if(m.role==='assistant'){
   const actions=document.createElement('div');
   actions.className='ai-actions';

   const copy=document.createElement('button');
   copy.type='button';copy.textContent='📋';
   copy.addEventListener('click',async()=>{
    try{
     await navigator.clipboard.writeText(m.text);
     statusBox.textContent='تم نسخ الرد';
    }catch(e){statusBox.textContent='تعذر النسخ من المتصفح';}
   });

   const react=document.createElement('button');
   react.type='button';react.textContent=m.reaction?'❤️':'👍';
   react.textContent=typeof m.reaction==='string'?m.reaction:(m.reaction?'❤️':'👍');
   const picker=document.createElement('div');
   picker.className='alk-reaction-picker';
   picker.hidden=true;
   const thanks=document.createElement('span');
   thanks.className='alk-reaction-thanks';
   thanks.textContent=m.reaction?'شكرًا لتفاعلك':'';
   const reactions=['❤️','😂','😮','😢','😡','👍'];
   for(const emoji of reactions){
    const choice=document.createElement('button');
    choice.type='button';
    choice.textContent=emoji;
    choice.setAttribute('aria-label','تفاعل '+emoji);
    choice.addEventListener('click',()=>{
     m.reaction=emoji;
     react.textContent=emoji;
     thanks.textContent=document.documentElement.lang==='en'?'Thanks for reacting':'شكرًا لتفاعلك';
     picker.hidden=true;
     save();
    });
    picker.appendChild(choice);
   }
   let pressTimer=null;
   let longPressed=false;
   react.addEventListener('pointerdown',()=>{
    longPressed=false;
    clearTimeout(pressTimer);
    pressTimer=setTimeout(()=>{
     longPressed=true;
     picker.hidden=false;
    },500);
   });
   ['pointerup','pointerleave','pointercancel'].forEach(eventName=>{
    react.addEventListener(eventName,()=>clearTimeout(pressTimer));
   });
   react.addEventListener('contextmenu',e=>e.preventDefault());
   react.addEventListener('click',()=>{
    if(longPressed){longPressed=false;return;}
    m.reaction=m.reaction?'':'👍';
    react.textContent=m.reaction||'👍';
    thanks.textContent=m.reaction?(document.documentElement.lang==='en'?'Thanks for reacting':'شكرًا لتفاعلك'):'';
    save();
   });

   const voice=document.createElement('button');
   voice.type='button';voice.textContent='🔊';
   voice.addEventListener('click',()=>{
    if(!('speechSynthesis' in window)){
     statusBox.textContent='الصوت غير مدعوم في هذا المتصفح';return;
    }

    const english=document.documentElement.lang==='en';
    let spokenText=String(m.text||'');
    if(!english){
      spokenText=spokenText
        .replace(/[\p{Extended_Pictographic}\p{Emoji_Presentation}\uFE0F\u200D]/gu,' ')
        .replace(/[A-Za-z][A-Za-z0-9._-]*/g,' ')
        .replace(/\s+/g,' ').trim();
    }else{
      spokenText=spokenText
        .replace(/[\p{Extended_Pictographic}\p{Emoji_Presentation}\uFE0F\u200D]/gu,' ')
        .replace(/\s+/g,' ').trim();
    }
    if(!spokenText)return;
    speechSynthesis.cancel();
    const utterance=new SpeechSynthesisUtterance(spokenText);
    utterance.lang=english?'en-US':'ar-EG';
    utterance.rate=0.96;
    utterance.pitch=1.08;
    const voices=speechSynthesis.getVoices();
    const matching=voices.filter(v=>english?/^en/i.test(v.lang):/^ar/i.test(v.lang));
    const preferred=matching.find(v=>/female|woman|hoda|salma|amira|laila|layla/i.test(v.name));
    if(preferred)utterance.voice=preferred;
    speechSynthesis.speak(utterance);
   });

   const share=document.createElement('button');
   share.type='button';share.textContent='↗️';
   share.addEventListener('click',async()=>{
    try{
     if(navigator.share){
      await navigator.share({title:'ALKFORY AI',text:m.text});
     }else{
      await navigator.clipboard.writeText(m.text);
      statusBox.textContent='تم نسخ الرد للمشاركة';
     }
    }catch(e){
     if(e.name!=='AbortError')statusBox.textContent='تعذرت المشاركة';
    }
   });

   actions.append(copy,react,voice,share,picker,thanks);
   el.appendChild(actions);
  }
 }
 box.scrollTop=box.scrollHeight;
}
draw();


const alkMenu=document.getElementById('alkMenu');
document.getElementById('menuOpen').addEventListener('click',()=>alkMenu.hidden=false);
document.getElementById('menuClose').addEventListener('click',()=>alkMenu.hidden=true);
alkMenu.addEventListener('click',e=>{if(e.target===alkMenu)alkMenu.hidden=true;});

function applyAlkTheme(){
 const dark=localStorage.getItem('alkfory_theme')!=='light';
 document.body.style.background=dark?'#090909':'#f3f3f3';
 document.body.style.color=dark?'#f5f5f5':'#171717';
 document.querySelectorAll('.msg.user').forEach(x=>x.style.background=dark?'#252525':'#dedede');
 document.querySelectorAll('textarea').forEach(x=>{
  x.style.background=dark?'#171717':'#fff';
  x.style.color=dark?'#fff':'#171717';
 });
}
applyAlkTheme();
document.getElementById('themeToggle').addEventListener('click',()=>{
 localStorage.setItem('alkfory_theme',localStorage.getItem('alkfory_theme')==='light'?'dark':'light');
 applyAlkTheme();
});

function applyAlkLanguage(){
 const english=localStorage.getItem('alkfory_language')==='en';
 document.documentElement.lang=english?'en':'ar';
 document.documentElement.dir=english?'ltr':'rtl';
 document.getElementById('text').placeholder=english?'Write your message...':'اكتب رسالتك هنا...';
 const sendButton=document.getElementById('send');
 sendButton.textContent='↑';
 sendButton.title=english?'Send message':'إرسال الرسالة';
 sendButton.setAttribute('aria-label',sendButton.title);
 document.getElementById('status').textContent=english?'Ready':'مساعدك جاهز. اكتب سؤالك.';
 document.querySelector('header span').textContent=english?'⚜️ ALKFORY AI':'⚜️ ALKFORY AI';
}
applyAlkLanguage();
document.getElementById('languageToggle').addEventListener('click',()=>{
 localStorage.setItem('alkfory_language',localStorage.getItem('alkfory_language')==='en'?'ar':'en');
 applyAlkLanguage();
});

document.getElementById('developerOpen').addEventListener('click',()=>location.href='/admin');
document.getElementById('platformOpen').addEventListener('click',()=>location.href='/platforms');

form.addEventListener('submit',async e=>{
 e.preventDefault();
 const message=input.value.trim();
 const imageFile=document.getElementById('image').files[0];
 if(!message && !imageFile)return;
 if(imageFile && imageFile.size > 4 * 1024 * 1024){
  statusBox.textContent='حجم الصورة أكبر من الحد المسموح (4 ميجابايت).';
  return;
 }
 let image=null;
 if(imageFile){
