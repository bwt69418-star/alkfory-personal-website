<script>
(function(){
 if(window.__alkforyVoiceScreenV2)return;
 window.__alkforyVoiceScreenV2=true;

 const screen=document.getElementById('alkforyVoiceScreen');
 const call=document.getElementById('alkCallButton');
 const orb=document.getElementById('alkVoiceOrb');
 const caption=document.getElementById('alkVoiceCaption');
 const photo=document.getElementById('alkVoicePhoto');
 const cancel=document.getElementById('alkVoiceCancel');
 const pause=document.getElementById('alkVoicePause');
 const close=document.getElementById('alkVoiceClose');
 const input=document.getElementById('message') ||
              document.querySelector('#form textarea');
 const form=document.getElementById('form') ||
             (input && input.closest('form'));
 const Recognition=window.SpeechRecognition || window.webkitSpeechRecognition;

 if(!screen || !call || !input || !form)return;

 // البحث عن صورة الحساب في عناصر الموقع
 const profile=document.querySelector(
  '#profileImage,#profile-image,#avatar,.profile img,.profile-image,img.avatar'
 );
 if(profile && profile.src)photo.src=profile.src;
 else photo.style.display='none';

 let active=false,paused=false,recognition=null,lastReply='',observer=null;

 function status(t){caption.textContent=t}
 function stopRecognition(){
  if(recognition){try{recognition.stop()}catch(e){} recognition=null}
 }
 function stopAll(){
  active=false;paused=false;stopRecognition();
  if('speechSynthesis' in window)speechSynthesis.cancel();
  if(observer)observer.disconnect();
  observer=null;orb.className='';pause.textContent='Ⅱ';
  pause.classList.remove('paused');
 }
 function closeScreen(){
  stopAll();screen.classList.remove('open');
 }
 function speak(text){
  if(!active || paused || !text || !('speechSynthesis' in window))return;
  text=String(text)
   .replace(/[\p{Extended_Pictographic}\uFE0F\u200D]/gu,' ')
   .replace(/\s+/g,' ').trim();
  if(!text)return;
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  const en=document.documentElement.lang==='en';
  u.lang=en?'en-US':'ar-EG';u.rate=.96;u.pitch=1.12;
  const voices=speechSynthesis.getVoices();
  const matching=voices.filter(v=>en?/^en/i.test(v.lang):/^ar/i.test(v.lang));
  const female=matching.find(v=>/female|woman|hoda|salma|amira|laila|layla|zira/i.test(v.name));
  if(female)u.voice=female;
  u.onstart=()=>{orb.className='speaking';status('ALKFORY AI بيتكلم...')};
  u.onend=()=>{orb.className='';if(active&&!paused)status('اضغط زر التحدث للمتابعة')};
  u.onerror=()=>{orb.className='';status('تعذر تشغيل الصوت على هذا الجهاز')};
  speechSynthesis.speak(u);
 }

 function findLatestReply(){
  const selectors=[
   '.message.assistant','.assistant-message',
   '[data-role="assistant"]','.ai-message',
   '.message.bot','.bot-message'
  ];
  let nodes=[];
  selectors.forEach(sel=>document.querySelectorAll(sel).forEach(n=>nodes.push(n)));
  nodes=[...new Set(nodes)];
  for(let i=nodes.length-1;i>=0;i--){
   const t=(nodes[i].innerText||'').trim();
   if(t && t!==lastReply){
    lastReply=t;
    return t;
   }
  }
  return '';
 }

 function watchReply(){
  if(observer)observer.disconnect();
  observer=new MutationObserver(()=>{
   if(!active||paused)return;
   const reply=findLatestReply();
   if(reply){
    observer.disconnect();observer=null;
    speak(reply);
   }
  });
  observer.observe(document.body,{subtree:true,childList:true,characterData:true});
  setTimeout(()=>{
   if(observer){
    observer.disconnect();observer=null;
    if(active&&!paused)status('الرد لم يظهر بعد؛ حاول مرة أخرى');
   }
  },90000);
 }

 function listen(){
  if(!active||paused)return;
  if(!Recognition){status('التعرف على الصوت غير مدعوم في المتصفح');return}
  recognition=new Recognition();
  recognition.lang=document.documentElement.lang==='en'?'en-US':'ar-EG';
  recognition.continuous=false;recognition.interimResults=false;
  recognition.onstart=()=>{orb.className='listening';status('أنا بسمعك... اتكلم')};
  recognition.onresult=e=>{
   const words=e.results[0][0].transcript.trim();
   if(!words)return;
   input.value=words;
   input.dispatchEvent(new Event('input',{bubbles:true}));
   status('جاري إرسال كلامك...');
   watchReply();
   form.requestSubmit();
  };
  recognition.onerror=()=>status('تعذر التقاط الصوت؛ اضغط للتحدث مرة أخرى');
  recognition.onend=()=>{if(active&&!paused){orb.className='';if(!observer)status('اضغط زر التحدث للمتابعة')}};
  try{recognition.start()}catch(e){status('تعذر بدء الميكروفون')}
 }

 function openScreen(){
  stopAll();active=true;screen.classList.add('open');
  status('اضغط زر التحدث وابدأ كلامك');
  listen();
 }

 call.addEventListener('click',e=>{e.preventDefault();openScreen()});
 cancel.addEventListener('click',closeScreen);
 close.addEventListener('click',closeScreen);

 pause.addEventListener('click',()=>{
  if(!active)return;
  paused=!paused;
  if(paused){
   stopRecognition();
   if('speechSynthesis' in window)speechSynthesis.pause();
   pause.textContent='▶';pause.classList.add('paused');
   status('المحادثة متوقفة مؤقتًا');
  }else{
   pause.textContent='Ⅱ';pause.classList.remove('paused');
   if('speechSynthesis' in window && speechSynthesis.paused){
    speechSynthesis.resume();status('استكمال صوت الرد...');
   }else{
    status('اضغط زر التحدث للمتابعة');listen();
   }
  }
 });
})();
</script>


