<div id="alkMenu" hidden style="position:fixed;inset:0;z-index:20;background:#000b">
 <aside style="position:absolute;right:0;top:0;bottom:0;width:min(300px,85%);background:#111;border-left:1px solid #8b0000;padding:18px;overflow:auto">
  <button id="menuClose" type="button">إغلاق ✕</button>
  <h3 style="color:#ff4545">⚜️ قائمة ALKFORY</h3>
  <hr>
  <h4>إعدادات التطبيق</h4>
  <button id="themeToggle" type="button" style="width:100%;margin:5px 0">تغيير الألوان والثيم</button>
  <button id="languageToggle" type="button" style="width:100%;margin:5px 0">العربية / English</button>
  <hr>
  <button id="developerOpen" type="button" style="width:100%;margin:5px 0">رسائل المطور الواردة</button>
  <button id="platformOpen" type="button" style="width:100%;margin:5px 0">منصة الكفوري</button>
 </aside>
