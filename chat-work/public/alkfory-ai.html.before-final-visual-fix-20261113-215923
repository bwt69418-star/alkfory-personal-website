<script>
(function(){
  if(window.alkforyVoiceChat) return;
  window.alkforyVoiceChat = true;

  const mic = document.getElementById('alkMicButton') ||
              document.getElementById('mic');
  if(!mic) return;

  const Recognition = window.SpeechRecognition ||
                      window.webkitSpeechRecognition;
  let listening = false;
  let recognition = null;

  mic.title = 'محادثة صوتية: اضغط للتحدث';
  mic.setAttribute('aria-label','بدء المحادثة الصوتية');

  mic.addEventListener('click', function(){
    if(!Recognition){
      const box = document.getElementById('status') ||
                  document.getElementById('statusBox');
      if(box) box.textContent =
        'التعرف الصوتي غير مدعوم في هذا المتصفح.';
      return;
    }

    if(listening){
      try { recognition.stop(); } catch(e) {}
      listening = false;
      mic.classList.remove('voice-listening');
      return;
    }

    recognition = new Recognition();
    recognition.lang =
      document.documentElement.lang === 'en' ? 'en-US' : 'ar-EG';
    recognition.continuous = false;
    recognition.interimResults = false;

    recognition.onstart = function(){
      listening = true;
      mic.classList.add('voice-listening');
      mic.title = 'استمع الآن... اضغط للإيقاف';
    };

    recognition.onresult = function(event){
      const spoken = event.results[0][0].transcript.trim();
      const input = document.getElementById('message') ||
                    document.querySelector('textarea');
      if(!input || !spoken) return;
      input.value = spoken;
      input.dispatchEvent(new Event('input',{bubbles:true}));
      const form = document.getElementById('form') ||
                   input.closest('form');
      if(form) form.requestSubmit();
    };

    recognition.onerror = function(){
      const box = document.getElementById('status') ||
                  document.getElementById('statusBox');
      if(box) box.textContent = 'تعذر التقاط الصوت؛ حاول مرة أخرى.';
    };

    recognition.onend = function(){
      listening = false;
      mic.classList.remove('voice-listening');
      mic.title = 'محادثة صوتية: اضغط للتحدث';
    };

    try { recognition.start(); }
    catch(e) { listening = false; }
  });
})();
</script>


